---
import "../../styles/global.scss";
import Layout from "../../layouts/Layout.astro";
const title: string = "Zcrew Pancakes | Owen Portfolio";
import { Image } from "astro:assets";
import zcrew1 from "../../assets/design/zcrew/zcrew.png";
---

<Layout title={title}>
  <main>
    <section class="zcrew-images">
      <Image src={zcrew1} alt="Zcrew Pancakes" />
    </section>
  </main>
</Layout>

<style lang="scss">
  .zcrew-images {
    width: 80vw;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    img {
      width: 100%;
      height: auto;
    }
  }
</style>
