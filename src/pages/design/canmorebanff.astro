---
import "../../styles/global.scss";
import Layout from "../../layouts/Layout.astro";
const title: string = "Canmore&Banff | Owen Portfolio";
import { Image } from "astro:assets";
import canmorebanff1 from "../../assets/design/canmore/1.jpg";
import canmorebanff2 from "../../assets/design/canmore/2.jpg";
import canmorebanff3 from "../../assets/design/canmore/3.jpg";
import canmorebanff4 from "../../assets/design/canmore/4.jpg";
import canmorebanff5 from "../../assets/design/canmore/5.jpg";
import canmorebanff6 from "../../assets/design/canmore/6.jpg";
import canmorebanff7 from "../../assets/design/canmore/7.jpg";
import canmorebanff8 from "../../assets/design/canmore/8.jpg";
import canmorebanff9 from "../../assets/design/canmore/9.jpg";
---

<Layout title={title}>
  <main>
    <section class="canmorebanff-images">
      <Image src={canmorebanff1} alt="Canmore&Banff" />
      <Image src={canmorebanff2} alt="Canmore&Banff" />
      <Image src={canmorebanff3} alt="Canmore&Banff" />
      <Image src={canmorebanff4} alt="Canmore&Banff" />
      <Image src={canmorebanff5} alt="Canmore&Banff" />
      <Image src={canmorebanff6} alt="Canmore&Banff" />
      <Image src={canmorebanff7} alt="Canmore&Banff" />
      <Image src={canmorebanff8} alt="Canmore&Banff" />
      <Image src={canmorebanff9} alt="Canmore&Banff" />
    </section>
  </main>
</Layout>

<style lang="scss">
  .canmorebanff-images {
    width: 50vw;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    img {
      width: 100%;
      height: auto;
    }
  }
</style>
