---
import "../styles/global.scss";
import Layout from "../layouts/Layout.astro";
const title: string = "Photography | Owen Portfolio";
import { Image } from "astro:assets";
import photographyBanner from "../assets/photos/banner.jpg";
import montrealImage1 from "../assets/photos/montreal1.jpg";
import montrealImage2 from "../assets/photos/montreal2.jpg";
import montrealImage3 from "../assets/photos/montreal3.jpg";
import quebecCityImage1 from "../assets/photos/quebec-city1.jpg";
import quebecCityImage2 from "../assets/photos/quebec-city2.jpg";
import quebecCityImage3 from "../assets/photos/quebec-city3.jpg";
import quebecCityImage4 from "../assets/photos/quebec-city4.jpg";
import quebecCityImage5 from "../assets/photos/quebec-city5.jpg";
import sanyaImage1 from "../assets/photos/sanya1.jpg";
import sanyaImage2 from "../assets/photos/sanya2.jpg";
import sanyaImage3 from "../assets/photos/sanya3.jpg";
import sanyaImage4 from "../assets/photos/sanya4.jpg";
import sanyaImage5 from "../assets/photos/sanya5.jpg";
import sanyaImage6 from "../assets/photos/sanya6.jpg";
import sanyaImage7 from "../assets/photos/sanya7.jpg";
---

<Layout title={title}>
  <header>
    <div class="banner">
      <Image src={photographyBanner} alt="Photography Banner" />
    </div>
  </header>
  <main>
    <section class="introduction">
      <div class="intro-text">
        <h1>Photography</h1>
        <div class="intro-text-content">
          <div class="left">
            <p>
              Photography is one of my hobbies. Through it, I have refined my
              aesthetic sensibility. My awareness of light and colour has also
              deepened my understanding of graphic design.
            </p>
          </div>
          <div class="right">
            <p>
              Lenses | Tamron 28-200mm F/2.8-5.6 Di III RXD, Zeiss 50mm f1.4,
              Sony FE 50mm F1.2 GM
            </p>
            <p>Cameras | Sony Alpha 7 IV, Nikon DF</p>
          </div>
        </div>
      </div>
    </section>

    <section class="montreal">
      <Image
        class="montreal-image-1"
        src={montrealImage1}
        alt="Montreal Image"
      />
      <Image
        class="montreal-image-2"
        src={montrealImage2}
        alt="Montreal Image"
      />
      <Image
        class="montreal-image-3"
        src={montrealImage3}
        alt="Montreal Image"
      />
      <!-- <div class="montreal-text">
        <h2>Montreal</h2>
        <p>
          Montreal is Canada’s second-largest city and the cultural heart of the
          province of Quebec, Montreal offers a striking blend of old-world
          charm and modern urban life. The cobblestone streets and historic
          architecture of Old Montreal contrast beautifully with contemporary
          skylines viewed from Mount Royal, creating rich opportunities for both
          street and landscape photography. Vibrant neighborhoods like
          Plateau-Mont-Royal add colorful facades, murals, and everyday scenes
          that capture the city’s artistic spirit and multicultural energy.
        </p>
      </div> -->
    </section>

    <section class="quebec-city">
      <Image
        class="quebec-city-image-1"
        src={quebecCityImage1}
        alt="Quebec City Image"
      />
      <Image
        class="quebec-city-image-2"
        src={quebecCityImage2}
        alt="Quebec City Image"
      />
      <Image
        class="quebec-city-image-3"
        src={quebecCityImage3}
        alt="Quebec City Image"
      />
      <Image
        class="quebec-city-image-4"
        src={quebecCityImage4}
        alt="Quebec City Image"
      />
      <Image
        class="quebec-city-image-5"
        src={quebecCityImage5}
        alt="Quebec City Image"
      />
      <!-- <div class="quebec-city-text">
        <h2>Quebec City</h2>

        <p>
          Quebec City is a charming and historic city, known for its fortified
          Old Town, cobblestone streets, and European-style architecture. The
          iconic Château Frontenac, the scenic Dufferin Terrace, and the winding
          streets of Petit Champlain offer stunning opportunities for
          architectural and street photography. Seasonal changes, from colorful
          autumn leaves to winter snow, add dramatic light and mood, making
          Quebec City a rich canvas for capturing both timeless cityscapes and
          intimate urban moments.
        </p> -->
    </section>
    <section class="sanya">
      <div class="sanya-images">
        <Image class="sanya-image-1" src={sanyaImage1} alt="Sanya Image" />
        <Image class="sanya-image-2" src={sanyaImage2} alt="Sanya Image" />
        <Image class="sanya-image-3" src={sanyaImage3} alt="Sanya Image" />
      </div>

      <Image class="sanya-image-4" src={sanyaImage4} alt="Sanya Image" />
      <Image class="sanya-image-5" src={sanyaImage5} alt="Sanya Image" />
      <Image class="sanya-image-6" src={sanyaImage6} alt="Sanya Image" />
      <Image class="sanya-image-7" src={sanyaImage7} alt="Sanya Image" />

      <!-- <div class="sanya-text">
      <h2>Sanya</h2>
      <p>
        Sanya, Hainan, which is located in a beautiful island in the south of
        China. Most people choose to come during the winter because the weather
        is quite cozy, The climate here is subtropical. I dislike packed venues,
        and that's really unnecessary. That being said, the only thing you need
        to do here is be laid-back. So I spent all day staying in the hotel and
        went to the beach around dusk.
      </p>
    </div> -->
    </section>
  </main>
</Layout>

<style lang="scss">
  :root {
    --p-size-photography: clamp(0.6rem, 1.4vw, 1.8rem);
  }
  header {
    .banner {
      width: 100vw;
      height: auto;
      img {
        width: 100%;
        height: auto;
        object-fit: cover;
        object-position: top;
      }
    }
  }

  main {
    width: 80vw;
    max-width: 2400px;
    margin: 0 auto;
    h1 {
      font-size: var(--h1-size);
      font-weight: 100;
      margin-bottom: 2rem;
    }

    h2 {
      font-size: var(--h2-size);
      font-weight: 100;
      margin-bottom: 2rem;
    }
    p {
      font-size: var(--p-size-photography);
      font-weight: 100;
      line-height: 1.5;
    }
    a {
      text-decoration: underline;
      color: var(--text-color);
      font-size: 1.4rem;
      font-weight: 100;
      margin-top: 2rem;
    }
    .introduction {
      width: 80vw;
      margin: 4rem auto 4rem;
      width: 100%;
    }
    .intro-text {
      text-align: left;
      .intro-text-content {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 10%;
        .left {
          width: 45%;
        }
        .right {
          width: 45%;
          margin-left: auto;
          text-align: right;
          p {
            font-size: var(--p-size-photography);
          }
        }
      }
    }
  }
  .montreal {
    height: 200vh;
    margin: 6rem auto 6rem;
    position: relative;
    .montreal-image-1 {
      position: absolute;
      top: 0;
      left: 2vw;
      width: 100%;
      height: auto;
      object-fit: cover;
      object-position: center;
    }
    .montreal-image-2 {
      position: absolute;
      bottom: 2%;
      right: 0;
      width: 40%;
      height: auto;
      @media (max-width: 2500px) {
        bottom: 5%;
      }
      @media (max-width: 2300px) {
        bottom: 20%;
      }
      @media (max-width: 1900px) {
        bottom: 25%;
      }
      @media (max-width: 1600px) {
        bottom: 30%;
        width: 45%;
      }
      @media (max-width: 1400px) {
        bottom: 35%;
        width: 50%;
      }
      @media (max-width: 1200px) {
        bottom: 30%;
        width: 55%;
      }
    }
    .montreal-image-3 {
      position: absolute;
      bottom: -7%;
      left: 0vw;
      width: 40%;
      height: auto;
      @media (max-width: 1800px) {
        bottom: 0%;
      }
      @media (max-width: 1600px) {
        bottom: 3%;
      }
      @media (max-width: 1000px) {
        width: 90%;
      }
    }
    .montreal-text {
      position: absolute;
      top: 68%;
      left: 0vw;
      width: 40%;
      @media (max-width: 2500px) {
        top: 60%;
      }
      @media (max-width: 2300px) {
        top: 57%;
      }
      @media (max-width: 1900px) {
        top: 51%;
      }
      @media (max-width: 1700px) {
        top: 48%;
      }
      @media (max-width: 1500px) {
        top: 40%;
      }
      p {
        padding-bottom: 4rem;
      }
    }
  }

  .quebec-city {
    height: 230vh;
    margin: 6rem auto;
    position: relative;
    .quebec-city-image-1 {
      position: absolute;
      top: 0;
      right: 2%;
      width: 30%;
      height: auto;
      object-fit: cover;
      object-position: center;
      @media (max-width: 2400px) {
        width: 40%;
      }
      @media (max-width: 2000px) {
        width: 43%;
      }
    }
    .quebec-city-image-2 {
      position: absolute;
      bottom: 7vh;
      left: 0vw;
      width: 750px;
      height: auto;
      @media (max-width: 1100px) {
        width: 70%;
        bottom: 21%;
      }
    }
    .quebec-city-image-3 {
      position: absolute;
      top: 24%;
      left: 0vw;
      width: 40%;
      height: auto;
      z-index: 10;
      @media (max-width: 2400px) {
        width: 50%;
      }
    }
    .quebec-city-image-4 {
      position: absolute;
      top: 110vh;
      right: 2vw;
      width: 550px;
      height: auto;
      z-index: 5;
      @media (max-width: 1100px) {
        top: 30%;
        width: 80%;
      }
    }
    .quebec-city-image-5 {
      position: absolute;
      bottom: 0vh;
      right: 0;
      width: 600px;
      height: auto;
      @media (max-width: 1100px) {
        width: 90%;
        bottom: 0%;
      }
    }
    .quebec-city-text {
      position: absolute;
      top: 50%;
      left: 0vw;
      width: 600px;
      @media (max-width: 1600px) {
        width: 40%;
      }
      @media (max-width: 1400px) {
        width: 30%;
      }
      @media (max-width: 1100px) {
        width: 100%;
      }
      p {
        padding-bottom: 4rem;
      }
    }
  }

  .sanya {
    height: 230vh;
    margin: 22rem auto;
    position: relative;
    .sanya-images {
      width: 100%;
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      justify-content: center;
      align-items: center;
      gap: 1rem;
      .sanya-image-1,
      .sanya-image-2,
      .sanya-image-3 {
        width: 100%;
        height: auto;
        object-fit: cover;
        object-position: center;
      }
    }

    .sanya-image-4 {
      position: absolute;
      top: 60%;
      right: 0;
      width: 55%;
      height: auto;
      object-fit: cover;
      object-position: center;
      z-index: 10;
      @media (max-width: 2400px) {
        width: 52%;
      }
    }

    .sanya-image-5 {
      position: absolute;
      top: 80vh;
      left: 0;
      width: 40%;
      height: auto;
      object-fit: cover;
      object-position: center;
      z-index: 5;
      @media (max-width: 2400px) {
        width: 45%;
      }
      @media (max-width: 2000px) {
        width: 40%;
      }
      @media (max-width: 1800px) {
        width: 38%;
      }
      @media (max-width: 1200px) {
        top: 36%;
      }
      @media (max-width: 1000px) {
        width: 90%;
      }
    }

    .sanya-image-6 {
      position: absolute;
      bottom: 0;
      right: 0;
      width: 65%;
      max-width: 1200px;
      height: auto;
      z-index: 5;
    }
    .sanya-image-7 {
      position: absolute;
      bottom: 10%;
      left: 0;
      width: 40%;
      height: auto;
      object-fit: cover;
      object-position: center;
      z-index: 10;
    }

    .sanya-text {
      max-width: 1400px;
      margin: 0 auto;
      text-align: center;
      align-items: center;
      margin: 6rem auto;
    }
  }
</style>
