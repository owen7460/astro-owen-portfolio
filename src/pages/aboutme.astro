  <script>
    function checkBrowser() {
      const firstPartBase = document.querySelector(".first-part-base");
      const thirdPart = document.querySelector(".third-part");
      const isScrollTimelineSupported = CSS.supports(
        "animation-timeline: scroll()",
      );
      if (isScrollTimelineSupported) {
        firstPartBase?.classList.add("not-firefox-first-part-base");
      } else {
        thirdPart?.classList.add("is-firefox-third-part");
      }
    }

    function initAboutPage() {
      checkBrowser();
    }

    document.addEventListener("DOMContentLoaded", initAboutPage);
    document.addEventListener("astro:page-load", initAboutPage);
  </script>
