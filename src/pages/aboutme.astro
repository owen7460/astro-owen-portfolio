          align-items: center;
          gap: 2rem;
          .vision-text-hr {
            width: 2px;
            height: 100px;
            background-color: var(--background-color);
          }
          .right-text {
            text-align: left;
            p {
              font-size: var(--p-size);
              font-weight: 100;
              line-height: 1.5;
              color: var(--background-color);
            }
          }
        }

        .my-skills {
          display: flex;
          justify-content: center;
          align-items: flex-start;
          gap: 2rem;
          width: 100%;
          max-width: 1200px;
