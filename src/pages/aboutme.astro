            bottom: 46%;
            letter-spacing: 0.5rem;
          }

          @media (max-width: 1200px) {
            font-size: 9rem;
            bottom: 48%;
            letter-spacing: 0.3rem;
          }
          @media (max-width: 1100px) {
            font-size: 8rem;

            letter-spacing: 0.2rem;
          }
          @media (max-width: 1000px) {
            font-size: 6rem;
            letter-spacing: 0.1rem;
          }

          @keyframes vision-title-animation {
            from {
              filter: blur(50px);
            }
            to {
              filter: blur(0px);
            }
          }
        }
      }

      .container {
        z-index: 10;
        position: absolute;
        text-align: center;
