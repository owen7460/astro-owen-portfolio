---
import "../styles/global.scss";
import Layout from "../layouts/Layout.astro";
const title: string = "Frontend development | Owen Portfolio";
import { Image } from "astro:assets";
import jokeshare from "../assets/frontend/jokeshare.png";
import card1 from "../assets/frontend/card1.png";
import card2 from "../assets/frontend/card2.png";
import card3 from "../assets/frontend/card3.png";
import card4 from "../assets/frontend/card4.png";
import card5 from "../assets/frontend/card5.png";
import card6 from "../assets/frontend/card6.png";
import card7 from "../assets/frontend/card7.png";
import card8 from "../assets/frontend/card8.png";
---

<Layout title={title}>
  <main>
    <section class="introduction">
      <div class="left">
        <h1><span>Design and Develop</span>Frontend</h1>
        <p>
          Frontend development is my favourite. When designing pages and
          components for users, seeing those beautiful and practical tools
          appear on the screen in real time is what excites me the most. With
          numerous frameworks and libraries available now, along with
          component-based development in React, our development efficiency has
          greatly improved.
        </p>
        <div class="technologies">
          <p>Frameworks | React, React Native, Next.js, Astro, SwiftUI, Vue3</p>
          <p>CSS | Tailwind CSS, Sass, Shadcn UI, Elementor Plus</p>
          <p>Libraries | Redux, Zustand, Pinia, Axios, Lucide Icons</p>
          <p>Other | PHP, TypeScript, Lottie Animations, Figma</p>
        </div>
      </div>
      <div class="right">
        <div class="image-card card1">
          <Image src={card1} alt="Card 1" />
        </div>
        <div class="image-card card2">
          <Image src={card2} alt="Card 2" />
        </div>
        <div class="image-card card3">
          <Image src={card3} alt="Card 3" />
        </div>
        <div class="image-card card4">
          <Image src={card4} alt="Card 4" />
        </div>
        <div class="image-card card5">
          <Image src={card5} alt="Card 5" />
        </div>
        <div class="image-card card6">
          <Image src={card6} alt="Card 6" />
        </div>
        <div class="image-card card7">
          <Image src={card7} alt="Card 7" />
        </div>
        <div class="image-card card8">
          <Image src={card8} alt="Card 8" />
        </div>
      </div>
    </section>
    <section class="jokeshare">
      <div class="jokeshare-content">
        <div class="jokeshare-content-inner">
          <div class="left">
            <Image src={jokeshare} alt="Jokeshare" width={822} height={413} />
          </div>
          <div class="right">
            <h2>Jokeshare</h2>
            <p>
              A single page app that allows users to share, like and collect
              jokes.
            </p>
            <p>Built with React, Zustand and Tailwind CSS</p>
            <a href="https://owenouyang.com/">View Project</a>
          </div>
        </div>
      </div>
    </section>
    <section>section 3</section>
    <section>section 4</section>
    <section>section 5</section>
  </main>

  <style lang="scss">
    main {
      scroll-snap-type: y mandatory;
      overflow-y: scroll;
      height: 100vh;
      h1 {
        font-size: 4.2rem;
        font-weight: 100;
        margin-bottom: 2rem;
        span {
          display: block;
          font-size: 3.2rem;
          font-weight: 900;
          line-height: 1.5;
        }
      }

      h2 {
        font-size: 3.2rem;
        font-weight: 100;
        margin-bottom: 2rem;
      }
      p {
        font-size: 1.2rem;
        font-weight: 100;
        line-height: 1.5;
      }
      a {
        text-decoration: underline;
        color: var(--text-color);
        font-size: 1.4rem;
        font-weight: 100;
        margin-top: 2rem;
      }

      section {
        scroll-snap-align: start;
        height: 100vh;
        width: 100vw;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .introduction {
        max-width: 2400px;
        gap: 8rem;
        margin: 0 auto;
        .left {
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: flex-start;
          gap: 2rem;
          width: 40%;
          padding-left: 10%;
          .technologies {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: flex-start;
            gap: 0.4rem;
            p {
              font-size: 1.05rem;
            }
          }
        }
        .right {
          width: 60%;
          padding-right: 10%;
          position: relative;
          height: 750px;
          display: flex;

          &:hover {
            .card1 {
              transform: translate3d(-30px, -10px, 0);
            }
            .card2 {
              transform: translate3d(0, -30px, 0);
            }
            .card3 {
              transform: translate3d(10px, 60px, 0);
            }
            .card4 {
              transform: translate3d(0, 0, 0);
            }
            .card5 {
              transform: translate3d(-5px, 5px, 0);
            }
            .card6 {
              transform: translate3d(0px, -30px, 0);
            }
            .card7 {
              transform: translate3d(40px, -20px, 0);
            }
            .card8 {
              transform: translate3d(0, -30px, 0);
            }
          }

          .image-card {
            position: absolute;
            border-radius: 16px;
            box-shadow: 5px 5px 10px 10px rgba(160, 160, 160, 0.4);
            overflow: hidden;
            transform: rotateY(-20deg) rotateX(20deg);
            transition: all 2s cubic-bezier(0.075, 0.82, 0.165, 1);

            img {
              width: 100%;
              height: 100%;
              object-fit: cover;
            }
          }
          .card1 {
            width: 356px;
            height: 99px;
            top: 50px;
            left: 0px;
            z-index: 1;
          }
          .card2 {
            width: 298px;
            height: 55px;
            top: 200px;
            left: 0px;
            z-index: 9;
          }
          .card3 {
            width: 151px;
            height: 328px;
            top: 300px;
            left: 30px;
            z-index: 8;
          }
          .card4 {
            width: 621px;
            height: 419px;
            top: 105px;
            left: 150px;
            z-index: 7;
          }
          .card5 {
            width: 349px;
            height: 287px;
            top: 450px;
            left: 250px;
            z-index: 8;
          }
          .card6 {
            width: 316px;
            height: 161px;
            top: 0px;
            left: 450px;
            z-index: 11;
          }
          .card7 {
            width: 253px;
            height: 125px;
            top: 250px;
            left: 550px;
            z-index: 10;
          }
          .card8 {
            width: 143px;
            height: 250px;
            top: 475px;
            left: 690px;
            z-index: 12;
          }
        }
      }

      .jokeshare-content {
        margin: 0 auto;
        text-align: center;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 1rem;
        .jokeshare-content-inner {
          display: flex;
          justify-content: space-between;
          align-items: center;
          gap: 2rem;
        }
      }
    }
  </style>
</Layout>
