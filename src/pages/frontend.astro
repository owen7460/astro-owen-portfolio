          z-index: 1;
          .front-jokeshare-lodash {
            animation-timeline: view();
            animation-name: fadeIn-opacity-scroll;
            animation-duration: 1s;
            animation-delay: 0.2s;
            animation-fill-mode: both;
          }
        }
      }

      .front-section-7 {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 2rem;
        .front-section-7-left {
          width: 65%;
          height: 100%;
          padding-left: 10%;
          position: relative;
          .front-kitchen-card {
            position: absolute;
            border-radius: 16px;
            box-shadow: 5px 5px 10px 10px rgba(160, 160, 160, 0.4);
            overflow: hidden;
            width: 600px;
            animation-timeline: view();
            animation-name: fadeIn-opacity-scroll-slow;
            animation-duration: 3s;
            animation-delay: 0.6s;
            animation-fill-mode: both;
            // animation-range: entry 0% entry 100%;
            img {
              width: 100%;
              height: 100%;
              object-fit: cover;
            }
          }

          @media (max-width: 1700px) {
            transform: scale(0.9);
          }
          @media (max-width: 1600px) {
            transform: scale(0.86);
          }
          @media (max-width: 1500px) {
            transform: scale(0.82);
          }
          @media (max-width: 1400px) {
            transform: scale(0.78);
          }
          @media (max-width: 1300px) {
            transform: scale(0.74);
          }
          .front-kitchen1 {
            top: 20%;
            left: 5%;
            z-index: 1;
          }
          .front-kitchen2 {
            top: 30%;
            left: 15%;
            z-index: 2;
          }
          .front-kitchen3 {
            top: 40%;
            left: 25%;
            z-index: 3;
          }
          .front-kitchen4 {
            top: 50%;
            left: 35%;
            z-index: 4;
          }
        }
        .front-section-7-right {
          scroll-snap-stop: none;
          width: 50%;
          display: flex;
          flex-direction: column;
          justify-content: flex-start;
