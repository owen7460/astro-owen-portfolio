      .front-last-section {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        flex-direction: column;
        gap: 6rem;
        .front-end-of-page {
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: center;
          gap: 3rem;
          h2 {
            font-size: var(--h2-size);
            font-weight: 100;
            max-width: 1100px;
            text-align: center;
            line-height: 1.4;
          }
          .front-technologies {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 0.4rem;
          }
          .p1 {
            animation-delay: 0.2s;
          }
          .p2 {
            animation-delay: 0.3s;
          }
          .p3 {
            animation-delay: 0.4s;
          }
          .p4 {
            animation-delay: 0.5s;
          }
          a {
            display: block;
            font-size: 0.8rem;
            font-weight: 100;
            padding: 0.6rem 1.6rem;
            background-color: rgba(255, 255, 255, 0.9);
            border-radius: 28px;
            box-shadow:
              var(--liquid-border-shadow),
              inset 0 0 10px 2px rgba(160, 160, 160, 0.2);
          }
        }
      }
    }
    .front-animation-title,
    .front-animation-text {
      opacity: 0;
      will-change: transform, opacity;
    }
  </style>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { initGsap, setupReveal } from "../utils/gsap/initGsap";

    function setupFrontendTextRevealGsap() {
      setupReveal(
        ".front-section-2 .front-animation-title, .front-section-2 .front-animation-text",
        {
          trigger: ".front-section-2",
          scroller: "main",
          start: "top 75%",
          y: 100,
          duration: 0.6,
          stagger: 0.3,
        },
      );

      setupReveal(
        ".front-section-3 .front-animation-title, .front-section-3 .front-animation-text",
        {
          trigger: ".front-section-3",
          scroller: "main",
          start: "top 75%",
          y: 100,
          duration: 0.6,
          stagger: 0.3,
        },
      );

      setupReveal(
        ".front-section-4 .front-animation-title, .front-section-4 .front-animation-text",
        {
          trigger: ".front-section-4",
          scroller: "main",
          start: "top 75%",
          y: 100,
          duration: 0.6,
          stagger: 0.6,
        },
      );

      setupReveal(".front-section-6 .front-animation-text", {
        trigger: ".front-section-6",
        scroller: "main",
        start: "top 75%",
        y: 100,
        duration: 1.2,
        stagger: 0.4,
      });

      setupReveal(
        ".front-section-7 .front-animation-title, .front-section-7 .front-animation-text",
        {
          trigger: ".front-section-7",
          scroller: "main",
          start: "top 75%",
          y: 30,
          duration: 0.8,
          stagger: 0.12,
        },
      );

      setupReveal(
        ".front-section-8 .front-section-8-title, .front-section-8 .front-section-8-content > .front-animation-text",
        {
          trigger: ".front-section-8",
          scroller: "main",
          start: "top 75%",
          y: 30,
          duration: 1.2,
          stagger: 0.3,
        },
      );

      setupReveal(
        ".front-last-section .front-animation-title, .front-last-section .front-animation-text",
        {
          trigger: ".front-last-section",
          scroller: "main",
          start: "top 75%",
          y: 30,
          duration: 0.8,
          stagger: 0.1,
        },
      );
    }

    function setupSection8CardsGsap() {
      initGsap();

      const cards = gsap.utils.toArray<HTMLElement>(".front-section8-card");
      if (!cards.length) return;

      cards.forEach((card) => {
        gsap.killTweensOf(card);
      });

      ScrollTrigger.getAll().forEach((trigger) => {
        if (
          trigger.trigger instanceof Element &&
          trigger.trigger.matches(".front-section8-cards")
        ) {
          trigger.kill();
        }
      });

      gsap.set(cards, {
        autoAlpha: 0,
        y: 40,
      });

      gsap.to(cards, {
        autoAlpha: 1,
        y: 0,
        duration: 0.8,
        ease: "power2.out",
        stagger: 0.15,
        scrollTrigger: {
          trigger: ".front-section8-cards",
          scroller: "main",
          start: "top 75%",
          once: true,
        },
      });
    }

    function initFrontendPage() {
      initGsap();
      setupFrontendTextRevealGsap();
      setupSection8CardsGsap();
    }

    document.addEventListener("DOMContentLoaded", initFrontendPage);
    document.addEventListener("astro:page-load", initFrontendPage);
  </script>
</FrontendLayout>
