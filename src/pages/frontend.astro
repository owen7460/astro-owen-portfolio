---
import "../styles/global.scss";
import "../styles/global.css";
import FrontendLayout from "../layouts/FrontendLayout.astro";
const title: string = "Frontend development | Owen Portfolio";
import { Image } from "astro:assets";
import card1 from "../assets/frontend/card1.png";
import card2 from "../assets/frontend/card2.png";
import card3 from "../assets/frontend/card3.png";
import card4 from "../assets/frontend/card4.png";
import card5 from "../assets/frontend/card5.png";
import card6 from "../assets/frontend/card6.png";
import card7 from "../assets/frontend/card7.png";
import card8 from "../assets/frontend/card8.png";
import blendbetterMac from "../assets/frontend/blendbetterMac.png";
import blendbetterMobile from "../assets/frontend/blendbetterMobile.png";
import blendbetterApple from "../assets/frontend/blendbetterApple.png";
import jokeshare from "../assets/frontend/jokeshare.png";
import zustand from "../assets/frontend/zustand.png";
import lodash from "../assets/frontend/lodash.png";
import kitchen1 from "../assets/frontend/kitchen1.png";
import kitchen2 from "../assets/frontend/kitchen2.png";
import kitchen3 from "../assets/frontend/kitchen3.png";
import kitchen4 from "../assets/frontend/kitchen4.png";
import Footer from "../components/Footer.astro";
import astro1 from "../assets/frontend/astro-1.png";
import astro2 from "../assets/frontend/astro-2.png";
import astro3 from "../assets/frontend/astro-3.png";
---

<FrontendLayout title={title}>
  <main>
    <section id="top" class="front-introduction">
      <div class="front-left">
        <h1><span>Design and Develop</span>Frontend</h1>
        <p class="front-intro-frontend">
          Frontend development is my favourite. When designing pages and
          components for users, seeing those beautiful layouts appear on the
          screen in real time is what excites me the most. With numerous
          frameworks and libraries available now, along with component-based
          development, our development efficiency has greatly improved
        </p>
        <div class="front-technologies">
          <p>Frameworks | React, React Native, Next.js, Astro, SwiftUI, Vue3</p>
          <p>CSS | Tailwind CSS, Sass, Shadcn UI, Element Plus</p>
          <p>Libraries | Redux, Zustand, Pinia, Axios, Lucide Icons</p>
          <p>Other | PHP, TypeScript, Lottie Animations, Figma</p>
        </div>
      </div>
      <div class="front-right">
        <div class="front-image-card front-card1">
          <Image
            loading="eager"
            src={card1}
            alt="Card for weather"
            width={356}
            height={99}
          />
        </div>
        <div class="front-image-card front-card2">
          <Image
            loading="eager"
            src={card2}
            alt="Card for tab bar"
            width={298}
            height={55}
          />
        </div>
        <div class="front-image-card front-card3">
          <Image
            loading="eager"
            src={card3}
            alt="Card for BlendBetter App"
            width={151}
            height={328}
          />
        </div>
        <div class="front-image-card front-card4">
          <Image
            loading="eager"
            src={card4}
            alt="Card for Owen's Kitchen"
            width={621}
            height={419}
          />
        </div>
        <div class="front-image-card front-card5">
          <Image
            loading="eager"
            src={card5}
            alt="Card for Jokeshare"
            width={349}
            height={287}
          />
        </div>
        <div class="front-image-card front-card6">
          <Image
            loading="eager"
            src={card6}
            alt="Card BlendBetter web"
            width={316}
            height={201}
          />
        </div>
        <div class="front-image-card front-card7">
          <Image
            loading="eager"
            src={card7}
            alt="Card for Vue project"
            width={253}
            height={125}
          />
        </div>
        <div class="front-image-card front-card8">
          <Image
            loading="eager"
            src={card8}
            alt="Card for Tailwind CSS"
            width={143}
            height={250}
          />
        </div>
      </div>
    </section>

    <section class="front-section-2">
      <div class="front-section-2-left">
        <Image
          class="front-blendbetter-mac"
          src={blendbetterMac}
          alt="Blendbetter"
          width={980 * 0.8}
          height={596 * 0.8}
        />
        <Image
          class="front-blendbetter-mobile"
          src={blendbetterMobile}
          alt="Blendbetter"
          width={195}
          height={406}
        />
      </div>
      <div class="front-section-2-right">
        <h2 class="front-animation-title">Next.js Project</h2>
        <p class="front-animation-text">
          BlendBetter is a multi-platform project. On the desktop side, I
          developed it using Next.js, whose routing system is very convenient,
          by organizing different pages as folders, I could automatically create
          the website’s routes. With the help of Tailwind CSS and shadcn/ui, the
          interface development was highly efficient. The sidebar design makes
          the site’s features clear at a glance, and Lucide Icons provide a
          clean visual style that makes buttons easy to recognize while reducing
          users’ reading effort.
        </p>
        <p class="front-animation-text">
          These advantages allowed me to complete the desktop version quickly. I
          then developed the mobile version using React Native, enabling
          BlendBetter to better serve both iOS and Android users with greater
          convenience in the kitchen.
        </p>
      </div>
    </section>

    <section class="front-section-3">
      <div class="front-section-3-left">
        <h2 class="front-animation-title">
          SwiftUI<span>Rebuilding BlendBetter</span>
        </h2>
        <p class="front-animation-text">
          After implementing the core mobile features with React Native, I set
          higher expectations for the project. This time, I wanted to use an
          on-device model to directly recognize fruit types. To better achieve
          this, I rebuilt the entire project using SwiftUI and leveraged Apple’s
          Vision framework.
        </p>
        <p class="front-animation-text">
          As a result, on iOS, users can directly use the camera to scan the
          fruits they have.
        </p>
      </div>
      <div class="front-section-3-middle">
        <Image
          class="front-blendbetter-apple"
          src={blendbetterApple}
          alt="Blendbetter detects fruits"
          width={1300 * 0.3}
          height={2642 * 0.3}
        />
      </div>
      <div class="front-section-3-right">
        <p class="front-animation-text">
          The app is currently in the final stage of development, and it is
          expected to be launched on the App Store within the next few weeks.
        </p>
        <img
          src="/appStore.png"
          width={320 * 0.5}
          height={108 * 0.5}
          alt="App Store"
        />
      </div>
    </section>

    <section class="front-section-4">
      <div class="front-section-4-left">
        <h2 class="front-animation-title">
          React Project<span>Single Page App</span>
        </h2>
        <p class="front-animation-text">
          Jokeshare is a typical React SPA project. In this web app, any user
          can browse and upload jokes, like and comment on them, and sort jokes
          by number of likes or by most recent. Users can also save jokes using
          the Collections feature.
        </p>
      </div>
      <div class="front-section-4-right">
        <Image
          class="front-jokeshare-image"
          src={jokeshare}
          alt="Jokeshare"
          width={1387 * 0.75}
          height={899 * 0.75}
        />
      </div>
    </section>

    <section class="front-section-5">
      <div class="front-section-5-content">
        <p>
          In this SPA project, I used Zustand for global state management.
          Compared to Redux, Zustand is more lightweight, simpler, and more
          efficient, which allowed me to implement the collections feature very
          quickly.
        </p>
        <p>
          For state persistence, I used Zustand’s built-in persist middleware,
          ensuring that users’ favourited jokes are saved locally and can be
          loaded again the next time they visit the website.
        </p>
      </div>
      <div class="front-section-5-image">
        <Image
          class="front-zustand"
          src={zustand}
          alt="Zustand"
          width={1371 * 0.7}
          height={941 * 0.7}
        />
      </div>
    </section>

    <section class="front-section-6">
      <div class="front-section-6-content">
        <p class="front-animation-text">
          I also used Lodash’s sorting utilities to implement dynamic joke
          ordering. When users click the sorting controls, a click event is
          triggered that applies different sorting strategies: one displays
          jokes in descending order based on the counts of likes, and the
          another one shows the newest jokes first based on their creation time.
        </p>
        <p class="front-animation-text">
          This approach keeps the sorting logic clean and efficient while
          providing users with a smooth way to switch between “Most Liked” and
          “Latest” views.
        </p>
        <div class="front-section-6-buttons">
          <img
            src="/likeButton.png"
            alt="Like Button"
            width={160}
            height={35}
          />
          <img
            src="/recentButton.png"
            alt="Recent Button"
            width={169}
            height={35}
          />
        </div>
      </div>
      <div class="front-section-6-lodash">
        <Image
          class="front-jokeshare-lodash"
          src={lodash}
          alt="Lodash"
          width={1285 * 0.62}
          height={873 * 0.62}
        />
      </div>
    </section>

    <section class="front-section-7">
      <div class="front-section-7-left">
        <div class="front-kitchen-card front-kitchen1">
          <Image
            loading="eager"
            src={kitchen1}
            alt="Card for Owen's Kitchen"
            width={2072}
            height={1046}
          />
        </div>
        <div class="front-kitchen-card front-kitchen2">
          <Image
            loading="eager"
            src={kitchen2}
            alt="Card for Owen's Kitchen"
            width={2053}
            height={1243}
          />
        </div>
        <div class="front-kitchen-card front-kitchen3">
          <Image
            loading="eager"
            src={kitchen3}
            alt="Card for Owen's Kitchen"
            width={2063}
            height={1243}
          />
        </div>
        <div class="front-kitchen-card front-kitchen4">
          <Image
            loading="eager"
            src={kitchen4}
            alt="Card for Owen's Kitchen"
            width={2076}
            height={1241}
          />
        </div>
      </div>
      <div class="front-section-7-right">
        <h2 class="front-animation-title">
          Owen's Kitchen <span>PHP Project</span>
        </h2>
        <p class="front-animation-text">
          Today, PHP still plays a very important role in development,
          especially for full-stack projects and applications that need to be
          built quickly. I enjoy cooking and sharing food, and Owen’s Kitchen is
          a project built with PHP and MySQL.
        </p>
        <p class="front-animation-text">
          It allows users to browse dishes, add items to a cart, leave notes
          (such as marking allergies to certain dishes), confirm orders, and
          view their balance and bills.
        </p>
      </div>
    </section>

    <section class="front-section-8">
      <div class="front-section-8-base">
        <div class="front-section-8-content">
          <div class="front-section-8-title front-animation-title">
            <img class="front-astro-logo" src="/icons/astro.svg" alt="Astro" />
            <h2>
              Owen's Portfolio<span>Astro Project</span>
            </h2>
          </div>
          <p class="front-animation-text">
            Astro is particularly well suited for performance-focused showcase
            websites.
          </p>
        </div>
        <div class="front-section8-cards">
          <div class="front-section8-card front-card1">
            <Image src={astro1} alt="Astro 1" />
            <div class="front-section8-card-text">
              <h3>SEO-Friendly Architecture</h3>
              <p>
                Astro provides a Layout system where each page can pass props to
                dynamically update elements like the title and metadata.
                Navigation is handled through client-side routing, enabling
                smooth transitions without full page reloads.
              </p>
              <p class="front-section8-card-invisible">
                Unlike traditional React apps that rely on client-side
                rendering, Astro delivers pre-rendered HTML by default,
                improving SEO and initial load performance—making it ideal for
                portfolio and content-focused websites.
              </p>
            </div>
          </div>
          <div class="front-section8-card front-card2">
            <Image src={astro2} alt="Astro 2" />
            <div class="front-section8-card-text">
              <h3>Island Architecture & Prefetching</h3>
              <p>
                Astro’s island architecture allows me to limit interactivity to
                specific React components, keeping the rest of the page
                lightweight and server-rendered.
              </p>
              <p class="front-section8-card-invisible">
                I also leveraged Astro’s prefetching strategy, so while users
                are still browsing the home page, the browser can begin
                preparing resources for other routes in the background. Combined
                with Astro’s optimized loading behavior, this reduces perceived
                loading delays, minimizes white screen flashes during
                navigation, and creates a smoother overall browsing experience.
              </p>
            </div>
          </div>
          <div class="front-section8-card front-card3">
            <Image src={astro3} alt="Astro 3" />
            <div class="front-section8-card-text">
              <h3>Image Optimization</h3>
              <p>
                Astro’s built-in Image component significantly improves image
                performance in this project. For example, one image originally
                sized at 1.9MB was optimized down to just 119KB after
                processing.
              </p>
              <p class="front-section8-card-invisible">
                The component also applies lazy loading by default and serves
                appropriately sized images for different devices, reducing load
                time while maintaining visual quality. This helps keep the site
                both visually appealing and performance-efficient.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="front-last-section">
      <div class="front-end-of-page">
        <h2 class="front-animation-title">
          Selecting the most suitable technologies for different application
          scenarios
        </h2>
        <div class="front-technologies">
          <p class="front-animation-text p1">
            Frameworks | React, React Native, Next.js, Astro, SwiftUI, Vue3
          </p>
          <p class="front-animation-text p2">
            CSS | Tailwind CSS, Sass, Shadcn UI, Element Plus
          </p>
          <p class="front-animation-text p3">
            Libraries | Redux, Zustand, Pinia, Axios, Lucide Icons
          </p>
          <p class="front-animation-text p4">
            Other | PHP, TypeScript, Lottie Animations, Figma
          </p>
        </div>
        <a href="#top">Back to Top</a>
      </div>
      <Footer />
    </section>
  </main>

  <style lang="scss">
    main {
      scroll-behavior: smooth;
      scroll-snap-type: y mandatory;
      overflow-y: scroll;
      height: 100vh;

      h1 {
        font-size: var(--h1-size);
        font-weight: 100;
        margin-bottom: 2rem;
        animation: fadeIn-slightly 0.7s ease-in-out both;
        animation-delay: 0.2s;
        span {
          display: block;
          font-size: var(--h1-span-size);
          font-weight: 900;
          line-height: 1.5;
          animation: fadeIn-slightly 0.6s ease-in-out both;
        }
      }
      p {
        font-size: var(--p-size);
        font-weight: 100;
        line-height: 1.5;
      }

      section {
        scroll-snap-align: start;
        scroll-snap-stop: always;
        height: 100vh;
        width: 100vw;
        display: flex;
        justify-content: center;
        align-items: center;
        max-width: 2400px;
        margin: 0 auto;
      }

      .front-introduction {
        max-width: 2400px;
        margin: 0 auto;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 5%;

        .front-left {
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: flex-start;
          gap: 1.4rem;
          width: 45%;
          padding-left: 5%;
          padding-right: 2%;
          .front-intro-frontend {
            animation: fadeIn-opacity 0.3s ease-in-out both;
            animation-delay: 0.5s;
          }
          .front-technologies {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: flex-start;
            gap: 0.4rem;
            animation: fadeIn-opacity 0.4s ease-in-out both;
            animation-delay: 0.6s;
            p {
              font-size: var(--p-size);
            }
          }
        }
        .front-right {
          width: 50%;
          padding-right: 5%;
          position: relative;
          height: 750px;
          display: flex;
          justify-content: flex-end;
          &:hover {
            .front-card1 {
              transform: translate3d(-30px, -10px, 0);
            }
            .front-card2 {
              transform: translate3d(0, -30px, 0);
            }
            .front-card3 {
              transform: translate3d(10px, 60px, 0);
            }
            .front-card4 {
              transform: translate3d(0, 0, 0);
            }
            .front-card5 {
              transform: translate3d(-5px, 5px, 0);
            }
            .front-card6 {
              transform: translate3d(0px, -30px, 0);
            }
            .front-card7 {
              transform: translate3d(40px, -20px, 0);
            }
            .front-card8 {
              transform: translate3d(0, -30px, 0);
            }
          }

          .front-image-card {
            position: absolute;
            border-radius: 16px;
            box-shadow: 5px 5px 10px 10px rgba(160, 160, 160, 0.4);
            overflow: hidden;
            transform: rotateY(-20deg) rotateX(20deg);
            transition: transform 2s cubic-bezier(0.075, 0.82, 0.165, 1);

            img {
              width: 100%;
              height: 100%;
              object-fit: cover;
            }
          }
          .front-card1 {
            width: 356px;
            height: 99px;
            top: 50px;
            left: 0px;
            z-index: 1;
          }
          .front-card2 {
            width: 298px;
            height: 55px;
            top: 200px;
            left: 0px;
            z-index: 9;
          }
          .front-card3 {
            width: 151px;
            height: 328px;
            top: 300px;
            left: 30px;
            z-index: 8;
          }
          .front-card4 {
            width: 621px;
            height: 419px;
            top: 105px;
            left: 150px;
            z-index: 7;
          }
          .front-card5 {
            width: 349px;
            height: 287px;
            top: 450px;
            left: 250px;
            z-index: 8;
          }
          .front-card6 {
            width: 316px;
            height: 201px;
            top: 0px;
            left: 450px;
            z-index: 11;
          }
          .front-card7 {
            width: 253px;
            height: 125px;
            top: 250px;
            left: 550px;
            z-index: 10;
          }
          .front-card8 {
            width: 143px;
            height: 250px;
            top: 475px;
            left: 690px;
            z-index: 12;
          }
        }
        @media (max-width: 1900px) {
          gap: 4%;

          .front-left {
            padding-left: 4.5%;
            padding-right: 0;
          }

          .front-right {
            transform: scale(0.96);
          }
        }

        @media (max-width: 1800px) {
          gap: 3%;

          .front-left {
            padding-left: 4%;
          }

          .front-right {
            transform: scale(0.87);
          }
        }

        @media (max-width: 1700px) {
          gap: 2%;

          .front-left {
            padding-left: 3.5%;
          }

          .front-right {
            transform: scale(0.84);
          }
        }

        @media (max-width: 1600px) {
          gap: 1%;

          .front-left {
            padding-left: 3%;
          }

          .front-right {
            transform: scale(0.76);
          }
        }
        @media (max-width: 1500px) {
          gap: 0;

          .front-left {
            padding-left: 2.5%;
          }

          .front-right {
            transform: scale(0.68);
          }
        }
        @media (max-width: 1400px) {
          .front-left {
            padding-left: 0;
            width: 40%;
          }

          .front-right {
            transform: scale(0.6);
          }
        }
        @media (max-width: 1300px) {
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: center;
          padding: 0 5rem;
          .front-left {
            width: 900px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 0;
            text-align: center;
            .front-technologies {
              display: none;
            }
            p {
              max-width: 800px;
            }
          }
          .front-right {
            width: 900px;
            height: 45%;
            margin: 0 auto;
            padding: 0;
            transform: scale(0.65);
          }
        }
      }

      .front-section-2 {
        background-image: url("../assets/frontend/blendbetterBG.png");
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        margin-right: 1rem;
        margin-top: 1rem;
        margin-bottom: 1rem;
        margin-left: 1rem;
        margin-right: 1rem;
        margin-top: 1rem;
        margin-bottom: 1rem;
        margin-left: 1rem;
        .front-section-2-left {
          width: 55%;
          position: relative;
          display: flex;
          justify-content: center;
          align-items: center;
          overflow: hidden;
          .front-blendbetter-mobile {
            position: absolute;
            bottom: 0px;
            right: 15px;
          }
        }
        .front-section-2-right {
          width: 45%;
          display: flex;
          flex-direction: column;
          justify-content: flex-start;
          align-items: flex-start;
          gap: 2rem;
          padding-left: 6rem;
          padding-right: 10%;
          h2 {
            font-size: var(--h2-size);
            font-weight: 100;
          }
        }
      }
      .front-section-3 {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 2rem;
        h2 {
          font-size: var(--h2-size);
          font-weight: 100;
          span {
            font-size: var(--h2-span-size);
            display: block;
            font-weight: 900;
            line-height: 1.2;
            margin-top: 0.4rem;
          }
        }
        p {
          font-size: var(--p-size);
          line-height: 1.5;
        }
        .front-section-3-left {
          width: 33%;
          display: flex;
          flex-direction: column;
          justify-content: flex-start;
          align-items: flex-start;
          gap: 2rem;
          padding-left: 10%;
        }
        .front-section-3-middle {
          width: 33%;
          display: flex;
          justify-content: center;
          align-items: center;
        }
        .front-blendbetter-apple {
          animation-timeline: view();
          animation-name: fadeIn-opacity-scroll;
          animation-duration: 1s;
          animation-delay: 0.2s;
          animation-fill-mode: both;
        }
        .front-section-3-right {
          width: 33%;
          display: flex;
          flex-direction: column;
          justify-content: flex-start;
          align-items: flex-start;
          gap: 2rem;
          padding-right: 10%;
        }
      }

      .front-section-4 {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 2rem;
        .front-section-4-left {
          width: 45%;
          display: flex;
          flex-direction: column;
          justify-content: flex-start;
          align-items: flex-start;
          gap: 2rem;
          padding-left: 10%;
          padding-right: 5%;
          h2 {
            font-size: var(--h2-size);
            font-weight: 100;
            span {
              font-size: var(--h2-span-size);
              display: block;
              font-weight: 900;
              line-height: 1.5;
              margin-top: 0.4rem;
            }
          }
          p {
            font-size: var(--p-size);
            font-weight: 100;
            line-height: 1.5;
          }
        }
        .front-section-4-right {
          width: 55%;
          overflow-x: clip;
          .front-jokeshare-image {
            animation-timeline: view();
