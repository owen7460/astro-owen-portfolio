      .front-section-8 {
        background-image: url("../assets/frontend/astrobg.jpg");
        bakcground-size: cover;
        background-position: left center;
        background-repeat: no-repeat;
        .front-astro-logo {
          width: 70px;
        }
        .front-section-8-base {
          padding: 0 5%;
          .front-section-8-content {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 2rem;
            text-align: center;
            color: var(--background-color);
            .front-section-8-title {
              display: flex;
              justify-content: center;
              align-items: center;
