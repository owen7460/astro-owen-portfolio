---
import "../styles/global.scss";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="hero">
    <div>
      <h1>Welcome to Owen's portfolio</h1>
      <p>Learning technologies to solve problems with the best solutions.</p>
      <p>This site is built with Astro*</p>
    </div>
  </div>
</Layout>

<style lang="scss">
  :root {
    --cardHeight: 40vw;
    --cardMargin: 4vw;
  }

  .hero {
    display: grid;
    justify-content: center;
    align-items: center;

    width: 100vw;
    height: 100vh;

    color: var(--text-color);
    text-align: center;

    h1 {
      font-size: 3.4vw;
      margin-bottom: 3.2vw;
      animation: fadeIn 0.4s ease-in-out forwards;
    }
    p {
      font-size: 1.8vw;
      font-weight: 300;
      letter-spacing: 0.1vw;
      animation: fadeIn 0.6s ease-in-out forwards;
      animation-delay: 0.1s;
      margin-bottom: 2vw;
    }
    p:nth-of-type(2) {
      font-size: 1vw;
      font-weight: 100;
      animation-delay: 0.2s;
    }

    background-color: #e493d0;
    background:
      radial-gradient(
        closest-side,
        rgba(235, 105, 78, 1),
        rgba(235, 105, 78, 0)
      ),
      radial-gradient(
        closest-side,
        rgba(243, 11, 164, 1),
        rgba(243, 11, 164, 0)
      ),
      radial-gradient(
        closest-side,
        rgba(254, 234, 131, 1),
        rgba(254, 234, 131, 0)
      ),
      radial-gradient(
        closest-side,
        rgb(170, 142, 254, 1),
        rgba(170, 142, 245, 0)
      ),
      radial-gradient(
        closest-side,
        rgb(248, 131, 124, 1),
        rgba(248, 192, 147, 0)
      );
    background-size:
      130vmax 130vmax,
      80vmax 80vmax,
      90vmax 90vmax,
      110vmax 110vmax,
      90vmax 90vmax;
    background-position:
      -80vmax -80vmax,
      60vmax -30vmax,
      10vmax 10vmax,
      -30vmax -10vmax,
      50vmax 50vmax;
    background-repeat: no-repeat;
    animation: move 12s linear infinite;
  }

  @keyframes move {
    0%,
    100% {
      background-size:
        130vmax 130vmax,
        80vmax 80vmax,
        80vmax 90vmax,
        110vmax 110vmax,
        90vmax 90vmax;
      background-position:
        -80vmax -80vmax,
        60vmax -30vmax,
        10vmax 10vmax,
        -30vmax -10vmax,
        50vmax 50vmax;
    }

    25% {
      background-size:
        40vmax 40vmax,
        110vmax 110vmax,
        20vmax 20vmax,
        30vmax 30vmax,
        110vmax 110vmax;
      background-position:
        -20vmax -20vmax,
        90vmax 90vmax,
        50vmax 50vmax,
        50vmax 30vmax,
        10vmax 30vmax;
    }
    50% {
      background-size:
        10vmax 10vmax,
        110vmax 110vmax,
        60vmax 70vmax,
        90vmax 90vmax,
        70vmax 70vmax;
      background-position:
        -80vmax -80vmax,
        60vmax -30vmax,
        10vmax 10vmax,
        -30vmax -10vmax,
        50vmax 50vmax;
    }

    75% {
      background-size:
        10vmax 10vmax,
        20vmax 20vmax,
        30vmax 30vmax,
        -90vmax -90vmax,
        50vmax 50vmax;
      background-position:
        -10vmax -50vmax,
        110vmax 110vmax,
        30vmax 40vmax,
        130vmax 10vmax,
        30vmax 30vmax;
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(150px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
