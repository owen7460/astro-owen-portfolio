---
import "../styles/global.scss";
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import blendbetter from "../assets/blendbetter.png";
import jokeshare from "../assets/jokeshare.jpg";
import owenkitchen from "../assets/owenkitchen.png";
import noirrose from "../assets/noirrose.png";
import portfolio from "../assets/portfolio.png";
import joMalone from "../assets/design-jomalone.png";
import goodreads from "../assets/design-goodreads.png";
import volvoCars from "../assets/design-volvo.png";
import calgaryStampede from "../assets/design-stampede.png";
import canmoreBanff from "../assets/design-canmorebanff.png";
import zCrewPancakes from "../assets/design-zcrew.png";
---

<Layout>
  <main>
    <section class="hero">
      <div>
        <h1>Welcome to Owen's portfolio</h1>
        <p>Learning technologies to solve problems with the best solutions.</p>
        <p>This site is built with Astro*</p>
      </div>
    </section>

    <section class="projects">
      <ul>
        <li>
          <div class="left">
            <Image src={blendbetter} alt="Blendbetter Website" />
          </div>
          <div class="right">
            <div class="right-content">
              <h2>Blendbetter</h2>
              <p>
                An AI-powered web app that recommends better smoothie
                combinations by suggesting fruit pairings based on taste and
                nutrition.
              </p>
              <p>
                Full-stack project, built with Next.js, TypeScript, Tailwind
                CSS, and Shadcn UI.
              </p>
              <div class="buttons">
                <a
                  href="https://github.com/owen7460/nextjs-blendbetter"
                  target="_blank">View Code</a
                >
                <a
                  class="view-project"
                  href="https://nextjs-blendbetter.vercel.app"
                  target="_blank">View Project</a
                >
              </div>
            </div>
          </div>
        </li>
        <li>
          <div class="left">
            <Image src={jokeshare} alt="Jokeshare Website" />
          </div>
          <div class="right">
            <div class="right-content">
              <h2>Jokeshare</h2>
              <p>
                A single page app that allows users to share, like and collect
                jokes.
              </p>
              <p>Built with React, Zustand, Tailwind CSS</p>
              <div class="buttons">
                <a
                  href="https://github.com/owen7460/joke-share-react"
                  target="_blank">View Code</a
                >
                <a
                  class="view-project"
                  href="https://owenouyang.com/"
                  target="_blank">View Project</a
                >
              </div>
            </div>
          </div>
        </li>
        <li>
          <div class="left">
            <Image src={owenkitchen} alt="Owen's Kitchen Website" />
          </div>
          <div class="right">
            <div class="right-content">
              <h2>Owen's Kitchen</h2>
              <p>
                Owen’s Kitchen is a web-based ordering system built with PHP and
                MySQL, allowing users to browse menus, place orders, and manage
                basic order data efficiently.
              </p>
              <p>Built with PHP, MySQL, HTML, CSS, JavaScript</p>
              <div class="buttons">
                <a
                  class="view-project"
                  href="https://owen-kitchen.com/"
                  target="_blank">View Project</a
                >
              </div>
            </div>
          </div>
        </li>
        <li>
          <div class="left">
            <Image src={noirrose} alt="Noir Rose Website" />
          </div>
          <div class="right">
            <div class="right-content">
              <h2>Noir Rose</h2>
              <p>
                Noir Rose is a press-on nails brand website designed to showcase
                the brand identity and product collections, while providing a
                smooth and intuitive online shopping experience for customers.
              </p>
              <p>Built with Wordpress, Elementor, and WooCommerce.</p>
              <div class="buttons">
                <a
                  class="view-project"
                  href="https://noir-rose.shop/"
                  target="_blank">View Project</a
                >
              </div>
            </div>
          </div>
        </li>
        <li>
          <div class="left">
            <Image src={portfolio} alt="Portfolio Website" />
          </div>
          <div class="right">
            <div class="right-content">
              <h2>Portfolio</h2>
              <p>
                This portfolio website is built with Astro, and it showcases my
                projects and skills.
              </p>
              <p>Built with Astro, Sass.</p>
              <div class="buttons">
                <a
                  class="view-project"
                  href="https://github.com/owen7460/astro-owen-portfolio"
                  target="_blank">View Code</a
                >
              </div>
            </div>
          </div>
        </li>
      </ul>
    </section>
    <section class="design">
      <div class="design-container">
        <div class="design-header">
          <h2>Design</h2>
          <p>
            As a developer, design is also important, as it gives me a stronger
            intuition for the user experience of a product.
          </p>
          <p>Here are some of my design projects.</p>
        </div>
        <ul>
          <li class="design-item">
            <h3>Jo Malone London</h3>
            <p>
              Jo Malone is a British fragrance brand known for its elegant,
              minimalist scents and signature cream-and-black packaging,
              representing understated luxury and refinement. This website
              design embraces the “liquid glass” trend, featuring a clean and
              modern layout, intuitive navigation, and a strong focus on
              showcasing the brand’s products and services.
            </p>
            <div class="design-item-image">
              <Image src={joMalone} alt="Jo Malone website" />
            </div>
          </li>
          <li class="design-item">
            <h3>Goodreads</h3>
            <p>
              Goodreads is a popular social platform where readers can discover
              books, track their reading progress, write reviews, and connect
              with other book lovers. However, its current web design feels
              dated—largely unchanged for over a decade—so this redesign adopts
              a more modern style, using component-based layouts to present
              users’ reading status in a clearer and more intuitive way.
            </p>
            <div class="design-item-image">
              <Image src={goodreads} alt="Goodreads website" />
            </div>
          </li>
          <li class="design-item">
            <h3>Volvo Cars</h3>
            <p>
              Volvo Cars is a Swedish automotive brand known for its commitment
              to safety, Scandinavian design, and engineering innovation. This
              project envisions a future-ready website tailored for the brand’s
              transition to electrification, presenting a clean, modern
              interface that highlights electric vehicles and sustainable
              mobility.
            </p>
            <div class="design-item-image">
              <Image src={volvoCars} alt="Volvo Cars website" />
            </div>
          </li>
          <li class="design-item">
            <h3>Calgary Stampede</h3>
            <p>
              Calgary Stampede is an iconic annual rodeo and festival in Calgary
              celebrating Western heritage, cowboy culture, and community
              spirit. This design project reimagines its visual identity by
              creating a new logo along with a comprehensive brand guideline to
              ensure consistent and modern usage across all media.
            </p>
            <div class="design-item-image">
              <Image src={calgaryStampede} alt="Calgary Stampede" />
            </div>
          </li>
          <li class="design-item">
            <h3>Canmore&Banff</h3>
            <p>
              I've visited Canmore many times, I was fascinated by those thick
              forests, majestic mountains and breathtaking northern lights.
              Recently I heard a story about some artists, many years ago they
              decided to live here just because of what they saw, I consider
              this a kind of heritage, and today it inspires me as well.
              Therefore, these works are designed for a brochure, it is intended
              to let more people realize that there is the best mountain view in
              our Alberta.
            </p>
            <div class="design-item-image">
              <Image src={canmoreBanff} alt="Canmore&Banff Brochure" />
            </div>
          </li>
          <li class="design-item">
            <h3>Zcrew Pancakes</h3>
            <p>
              Design often comes from the small details of everyday life. When I
              paid attention to the beautiful moments around me and transformed
              them through technical means—mixing 3D models and adjusting
              lighting and layers in Photoshop—they became a new work of art.
            </p>
            <div class="design-item-image">
              <Image src={zCrewPancakes} alt="Z-crew Pancakes" />
            </div>
          </li>
        </ul>
      </div>
    </section>
  </main>

  <style lang="scss">
    @use "../styles/mixins.scss" as mixins;
    :root {
      --cardHeight: 40vw;
      --cardMargin: 4vw;
    }

    .hero {
      display: grid;
      justify-content: center;
      align-items: center;

      width: 100vw;
      height: 100vh;

      color: var(--text-color);
      text-align: center;

      h1 {
        font-size: 3.4vw;
        margin-bottom: 3.2vw;
        animation: fadeIn 0.4s ease-in-out forwards;
      }
      p {
        font-size: 1.8vw;
        font-weight: 300;
        letter-spacing: 0.1vw;
        animation: fadeIn 0.6s ease-in-out forwards;
        animation-delay: 0.1s;
        margin-bottom: 2vw;
      }
      p:nth-of-type(2) {
        font-size: 1vw;
        font-weight: 100;
        animation-delay: 0.2s;
      }
    }

    .projects {
      width: 80vw;
      margin: 0 auto;

      li {
        overflow: hidden;
        position: sticky;
        top: 5vh;
        display: grid;
        grid-template-columns: 1fr 1fr;
        height: var(--cardHeight);
        margin-bottom: var(--cardMargin);
        background-color: rgba(255, 255, 255, 0.4);
        box-shadow: var(--liquid-border-shadow);
        backdrop-filter: blur(15px);
        border-radius: 1em;
        // animation: scaleIn 1s ease-in-out forwards;
        // animation-timeline: view();
        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          object-position: center;
        }
        .right {
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: flex-start;
          .right-content {
            width: 80%;
            margin: 0 auto;
          }
          h2 {
            font-weight: 100;
            font-size: 2.5em;
          }
          p {
            margin: 1em 0;
            font-size: 0.72em;
            margin-left: 0.2em;
          }
          p:last-of-type {
            margin-top: 3em;
            font-weight: 100;
          }
          .buttons {
            display: flex;
            justify-content: flex-start;
            align-items: center;
            gap: 0.2em;
            margin-top: 2.6em;
            a {
              font-size: 0.68em;
              padding: 0.4em 1em;
              border-radius: 26px;
              margin-right: 1em;
              border: 1px solid var(--text-color);
              backdrop-filter: blur(60px);
              background-color: transparent;
              &.view-project {
                background-color: var(--text-color);
                color: var(--background-color);
              }
              &:hover {
                box-shadow: 1px 2px 15px 1px rgba(96, 96, 96, 0.5);
              }
            }
          }
        }
      }
    }
    .design {
      position: relative;
      z-index: 1;
      &::before {
        content: "";
        position: absolute;
        inset: 0;
        @include mixins.gradient-background;
        transform: scaleY(-1);
        z-index: -5;
      }
      text-align: center;
      margin: 0 auto;

      .design-container {
        width: 80vw;
        margin: 6rem auto;
        padding: 6rem 0;
        .design-header {
          text-align: center;
          margin: 6rem auto;
          h2 {
            font-size: 3vw;
            margin-bottom: 1em;
          }
          p {
            font-size: 1.2vw;
            font-weight: 100;
            margin-bottom: 1em;
          }
        }

        ul {
          display: grid;
          grid-template-columns: repeat(auto-fill, minmax(500px, 1fr));
          gap: 1.6em;
          backdrop-filter: blur(12px);
          -webkit-backdrop-filter: blur(12px);
          .design-item {
            background-color: rgba(92, 92, 92, 0.2);
            box-shadow: var(--liquid-border-shadow);
            border-radius: 1em;
            padding: 2.6em 3em;
            text-align: left;
            color: var(--text-color);
            h3 {
              font-size: 1.6vw;
              font-weight: 500;
              margin-bottom: 0.8em;
            }
            p {
              font-size: 0.8vw;
              font-weight: 100;
              line-height: 1.5;
              margin-bottom: 3em;
              line-height: 1.8;
            }
            .design-item-image {
              width: 100%;
              object-fit: cover;
              object-position: center;
              margin: 0 auto;
              img {
                width: 100%;
                height: auto;
              }
            }
          }
        }
      }
    }

    .design-header h2,
    .design-header p {
      opacity: 0;

      &.visible {
        animation: fadeIn 0.8s ease-out forwards;
      }

      &:nth-of-type(1) {
        animation-delay: 0s;
      }
      &:nth-of-type(2) {
        animation-delay: 0.1s;
      }
      &:nth-of-type(3) {
        animation-delay: 0.3s;
      }
    }

    .design-item {
      opacity: 0;
      transform: translateY(50px);
      transition: all 0.8s ease-out;

      &.visible {
        opacity: 1;
        transform: translateY(0);
      }

      &:nth-of-type(1) {
        transition-delay: 0s;
      }
      &:nth-of-type(2) {
        transition-delay: 0.1s;
      }
      &:nth-of-type(3) {
        transition-delay: 0.2s;
      }
      &:nth-of-type(4) {
        transition-delay: 0.3s;
      }
      &:nth-of-type(5) {
        transition-delay: 0.4s;
      }
      &:nth-of-type(6) {
        transition-delay: 0.5s;
      }
    }

    // @keyframes scaleIn {
    //   0% {
    //     transform: scaleX(1);
    //   }
    //   100% {
    //     transform: scaleX(1);
    //   }
    // }
  </style>
  <script>
    if (typeof window !== "undefined") {
      const elementsToObserve = [
        ...document.querySelectorAll(".design-header h2, .design-header p"),
        ...document.querySelectorAll(".design-item"),
      ];

      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              obs.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.3 },
      );

      elementsToObserve.forEach((el) => observer.observe(el));
    }
  </script>
</Layout>
