---
import "../styles/global.scss";
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import blendbetter from "../assets/blendbetter.png";
import jokeshare from "../assets/frontend/jokeshare.png";
import owenkitchen from "../assets/owenkitchen.png";
import noirrose from "../assets/noirrose.png";
import portfolio from "../assets/portfolio.png";
import joMalone from "../assets/design-jomalone.png";
import goodreads from "../assets/design-goodreads.png";
import volvoCars from "../assets/design-volvo.png";
import calgaryStampede from "../assets/design-stampede.png";
import canmoreBanff from "../assets/design-canmorebanff.png";
import zCrewPancakes from "../assets/design-zcrew.png";
import dorc from "../assets/dorc.png";
---

<Layout>
  <main>
    <section class="hero">
      <div class="hero-content">
        <p class="title">Developer & Designer</p>
        <h1 class="title-h1">Portfolio.</h1>
        <div class="title-my-name-container">
          <p class="title-my-name">Owen Ouyang</p>
          <p class="title-year">2026</p>
        </div>

        <div class="title-description-container">
          <p>
            Learning technologies to solve problems with the best solutions.
          </p>
          <p>This site is built with Astro*</p>
        </div>
      </div>
    </section>

    <section class="projects">
      <ul>
        <li>
          <div class="left">
            <Image src={blendbetter} alt="Blendbetter Website" />
          </div>
          <div class="right">
            <div class="right-content">
              <h2>BlendBetter</h2>
              <p>
                A web app that shares tasty smoothie, milk tea, and cocktail
                recipes to help reduce fruit waste by turning leftover fruit
                into enjoyable drinks.
              </p>
              <p>
                Full-stack project, built with Next.js, TypeScript, Tailwind
                CSS, and Shadcn UI.
              </p>
              <div class="buttons">
                <a
                  href="https://github.com/owen7460/nextjs-blendbetter"
                  target="_blank">View Code</a
                >
                <a
                  class="view-project"
                  href="https://nextjs-blendbetter.vercel.app"
                  target="_blank">View Project</a
                >
              </div>
            </div>
          </div>
        </li>
        <li>
          <div class="left">
            <Image src={jokeshare} alt="Jokeshare Website" />
          </div>
          <div class="right">
            <div class="right-content">
              <h2>JokeShare</h2>
              <p>
                A single page app that allows users to share, like and collect
                jokes.
              </p>
              <p>Built with React, Zustand, Tailwind CSS</p>
              <div class="buttons">
                <a
                  href="https://github.com/owen7460/joke-share-react"
                  target="_blank">Frontend Code</a
                >
                <a
                  href="https://github.com/owen7460/joke_share_project"
                  target="_blank">Backend Code</a
                >
                <a
                  class="view-project"
                  href="https://owenouyang.com/"
                  target="_blank">View Project</a
                >
              </div>
            </div>
          </div>
        </li>
        <li>
          <div class="left">
            <Image src={dorc} alt="DORC Project" />
          </div>
          <div class="right">
            <div class="right-content">
              <h2>DORC</h2>
              <p>
                DORC is a MERN stack RPG-style productivity app that gamifies
                habit-building. Users create quests, earn XP, level up, unlock
                badges, and join guilds to stay motivated.
              </p>
              <p>
                This was a collaborative full-stack project with a separated
                frontend and backend architecture. I primarily worked on backend
                development, building RESTful APIs, designing data models, and
                implementing core logic to support the game’s progression
                system.
              </p>
              <p>Built with Express.js, MongoDB</p>
              <div class="buttons">
                <a
                  class="view-project"
                  href="https://github.com/chrisnordrum/dorc-app"
                  target="_blank">View Code</a
                >
              </div>
            </div>
          </div>
        </li>
        <li>
          <div class="left">
            <Image src={owenkitchen} alt="Owen's Kitchen Website" />
          </div>
          <div class="right">
            <div class="right-content">
              <h2>Owen's Kitchen</h2>
              <p>
                Owen’s Kitchen is a web-based ordering system built with PHP and
                MySQL, allowing users to browse menus, place orders, and manage
                basic order data efficiently.
              </p>
              <p>Built with PHP, MySQL, HTML, CSS, JavaScript</p>
              <div class="buttons">
                <a
                  class="view-project"
                  href="https://owen-kitchen.com/"
                  target="_blank">View Project</a
                >
              </div>
            </div>
          </div>
        </li>
        <li>
          <div class="left">
            <Image src={noirrose} alt="Noir Rose Website" />
          </div>
          <div class="right">
            <div class="right-content">
              <h2>Noir Rose</h2>
              <p>
                Noir Rose is a press-on nails brand website designed to showcase
                the brand identity and product collections, while providing a
                smooth and intuitive online shopping experience for customers.
              </p>
              <p>Built with Wordpress, Elementor, and WooCommerce.</p>
              <div class="buttons">
                <a
                  class="view-project"
                  href="https://noir-rose.shop/"
                  target="_blank">View Project</a
                >
              </div>
            </div>
          </div>
        </li>
        <li>
          <div class="left">
            <Image src={portfolio} alt="Portfolio Website" />
          </div>
          <div class="right">
            <div class="right-content">
              <h2>Portfolio</h2>
              <p>
                This portfolio website is built with Astro, and it showcases my
                projects and skills.
              </p>
              <p>Built with Astro, Sass.</p>
              <div class="buttons">
                <a
                  class="view-project"
                  href="https://github.com/owen7460/astro-owen-portfolio"
                  target="_blank">View Code</a
                >
              </div>
            </div>
          </div>
        </li>
      </ul>
    </section>
    <section class="design">
      <div class="design-container">
        <div class="design-header">
          <h2>Design</h2>
          <p>
            As a developer, design is also important, as it gives me a stronger
            intuition for the user experience of a product.
          </p>
          <p>Here are some of my design projects.</p>
        </div>

        <ul>
          <li class="design-item">
            <a href="/design/jomalone">
              <h3>Jo Malone London</h3>
              <p>
                Jo Malone is a British fragrance brand known for its elegant,
                minimalist scents and signature cream-and-black packaging,
                representing understated luxury and refinement. This website
                design embraces the “liquid glass” trend, featuring a clean and
                modern layout, intuitive navigation, and a strong focus on
                showcasing the brand’s products and services.
              </p>
              <div class="design-item-image">
                <Image src={joMalone} alt="Jo Malone website" />
              </div>
            </a>
          </li>

          <li class="design-item">
            <a href="/design/goodreads">
              <h3>Goodreads</h3>
              <p>
                Goodreads is a popular social platform where readers can
                discover books, track their reading progress, write reviews, and
                connect with other book lovers.
              </p>
              <div class="design-item-image">
                <Image src={goodreads} alt="Goodreads website" />
              </div>
            </a>
          </li>

          <li class="design-item">
            <a href="/design/volvocars">
              <h3>Volvo Cars</h3>
              <p>
                Volvo Cars is a Swedish automotive brand known for its
                commitment to safety, Scandinavian design, and engineering
                innovation. This project envisions a future-ready website
                tailored for the brand’s transition to electrification,
                presenting a clean, modern interface that highlights electric
                vehicles and sustainable mobility.
              </p>
              <div class="design-item-image">
                <Image src={volvoCars} alt="Volvo Cars website" />
              </div>
            </a>
          </li>

          <li class="design-item">
            <a href="/design/calgarystampede">
              <h3>Calgary Stampede</h3>
              <p>
                Calgary Stampede is an iconic annual rodeo and festival in
                Calgary celebrating Western heritage, cowboy culture, and
                community spirit. This design project reimagines its visual
                identity by creating a new logo along with a comprehensive brand
                guideline to ensure consistent and modern usage across all
                media.
              </p>
              <div class="design-item-image">
                <Image src={calgaryStampede} alt="Calgary Stampede" />
              </div>
            </a>
          </li>

          <li class="design-item">
            <a href="/design/canmorebanff">
              <h3>Canmore&Banff</h3>
              <p>
                I've visited Canmore many times, I was fascinated by those thick
                forests, majestic mountains and breathtaking northern lights.
                Recently I heard a story about some artists, many years ago they
                decided to live here just because of what they saw, I consider
                this a kind of heritage, and today it inspires me as well.
                Therefore, these works are designed for a brochure, it is
                intended to let more people realize that there is the best
                mountain view in our Alberta.
              </p>
              <div class="design-item-image">
                <Image src={canmoreBanff} alt="Canmore&Banff Brochure" />
              </div>
            </a>
          </li>

          <li class="design-item">
            <a href="/design/zcrew">
              <h3>Zcrew Pancakes</h3>
              <p>
                Design often comes from the small details of everyday life. When
                I paid attention to the beautiful moments around me and
                transformed them through technical means—mixing 3D models and
                adjusting lighting and layers in Photoshop—they became a new
                work of art.
              </p>
              <div class="design-item-image">
                <Image src={zCrewPancakes} alt="Z-crew Pancakes" />
              </div>
            </a>
          </li>
        </ul>
      </div>
    </section>
  </main>

  <style lang="scss">
    @use "../styles/mixins.scss" as mixins;
    :root {
      --title-size: clamp(1rem, 1vw, 2rem);
      --intro-text-size: 8rem;
      --intro-subtitle-size: clamp(1rem, 1.8vw, 2rem);
      --intro-subtitle-buildwith: clamp(0.8rem, 1vw, 1.2rem);
      --cardHeight: clamp(400px, 40vw, 800px);
      --cardMargin: 4vw;
    }

    body {
      @include mixins.gradient-background;
    }

    main {
      .hero {
        max-width: 2400px;
        margin: 0 auto;
        display: grid;
        justify-content: center;
        align-items: center;

        width: 100vw;
        height: 100vh;

        color: var(--text-color);
        text-align: center;

        .title {
          font-weight: 100;
          text-align: left;
          font-size: var(--title-size);
          margin-bottom: 0;
          animation: fadeIn 0.4s ease-in-out both;
        }
        .title-h1 {
          font-size: var(--intro-text-size);
          margin-bottom: 1rem;
          animation: fadeIn 0.4s ease-in-out both;
        }
        .title-my-name-container {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 0.5rem;
          p {
            font-size: var(--title-size);
            font-weight: 100;
            text-align: left;
            margin-bottom: 0;
          }
        }
        .title-description-container {
          position: absolute;
          bottom: 10%;
          left: 50%;
          transform: translateX(-50%);
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          p {
            font-size: 0.8rem;
            font-weight: 300;
            letter-spacing: 0.2px;
            animation: fadeIn 0.6s ease-in-out both;
            animation-delay: 0.1s;
            margin-bottom: 0.6vw;
          }
        }
        p {
          font-size: var(--intro-subtitle-size);
          font-weight: 300;
          letter-spacing: 0.2px;
          animation: fadeIn 0.6s ease-in-out both;
          animation-delay: 0.1s;
          margin-bottom: 2vw;
        }
        p:nth-of-type(2) {
          font-size: var(--intro-subtitle-buildwith);
          font-weight: 100;
          animation-delay: 0.2s;
        }
      }

      .projects {
        max-width: 1800px;
        width: 80vw;
        margin: 0 auto;

        li {
          overflow: hidden;
          position: sticky;
          // top: 5vh;

          display: grid;
          grid-template-columns: 1fr 1fr;
          height: var(--cardHeight);
          margin-bottom: var(--cardMargin);
          background-color: rgba(255, 255, 255, 0.4);
          box-shadow: var(--liquid-border-shadow);
          backdrop-filter: blur(15px);
          border-radius: 1em;
          // animation: scaleIn 1s ease-in-out forwards;
          // animation-timeline: view();
          img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
          }
          .right {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: flex-start;
            .right-content {
              width: 80%;
              margin: 0 auto;
            }
            h2 {
              font-weight: 900;
              font-size: var(--card-h2-size);
            }
            p {
              margin: 1em 0;
              font-size: var(--card-p-size);
              margin-left: 0.2em;
              letter-spacing: 0.2px;
              font-weight: 100;
            }
            p:last-of-type {
              margin-top: 3em;
            }
            .buttons {
              display: flex;
              justify-content: flex-start;
              align-items: center;
              flex-wrap: wrap;
              row-gap: 0.6rem;
              column-gap: 0.2rem;
              margin-top: 2.6em;
              a {
                font-size: var(--card-a-size);
                padding: 0.4em 1em;
                border-radius: 26px;
                margin-right: 1em;
                border: 1px solid var(--text-color);
                backdrop-filter: blur(60px);
                background-color: transparent;
                &.view-project {
                  background-color: var(--text-color);
                  color: var(--background-color);
                }
                &:hover {
                  box-shadow: 1px 2px 15px 1px rgba(96, 96, 96, 0.5);
                }
              }
            }
          }
        }

        li:nth-of-type(1) {
          top: 5vh;
        }
        li:nth-of-type(2) {
          top: 8vh;
          img {
            object-position: top left;
          }
        }
        li:nth-of-type(3) {
          top: 11vh;
        }
        li:nth-of-type(4) {
          top: 14vh;
        }
        li:nth-of-type(5) {
          top: 15vh;
        }
        @media (max-width: 1000px) {
          width: 95vw;
        }
        @media (max-width: 950px) {
          li {
            .right {
              .right-content {
                width: 90%;
              }
              p {
                font-size: var(--card-p-size-mobile);
              }
              .buttons {
                a {
                  font-size: var(--card-a-size-mobile);
                }
              }
              p:last-of-type {
                margin-top: 0;
              }
              .buttons {
                margin-top: 0.8em;
              }
            }
          }
        }
      }

      .design {
        position: relative;
        z-index: 1;
        &::before {
          content: "";
          position: absolute;
          inset: 0;
          @include mixins.gradient-background;
          transform: scaleY(-1);
          z-index: -5;
        }
        text-align: center;
        margin: 0 auto;

        .design-container {
          width: 80vw;
          max-width: 1800px;
          margin: 0 auto;
          padding: 6rem 0;
          .design-header {
            text-align: center;
            margin: 6rem auto;
            h2 {
              font-size: var(--h2-size);
              margin-bottom: 1em;
            }
            p {
              font-size: var(--p-size);
              font-weight: 100;
              margin-bottom: 1em;
            }
          }

          ul {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(500px, 1fr));
            gap: 1.6em;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);

            .design-item {
              a {
                display: block;
                width: 100%;
                height: 100%;
                background-color: rgba(201, 201, 201, 0.4);
                box-shadow: var(--liquid-border-shadow);
                border-radius: 1em;
                padding: 2.6em 3em;
                text-align: left;
                color: var(--text-color);
                transition: all 0.2s ease-in-out;
                &:hover {
                  transform: scale(1.02);
                }
              }

              h3 {
                font-size: var(--h3-size);
                font-weight: 500;
                margin-bottom: 0.8em;
              }
              p {
                font-size: var(--card-p-size);
                font-weight: 100;
                line-height: 1.5;
                margin-top: 1em;
                margin-bottom: 3em;
                line-height: 1.8;
              }
              .design-item-image {
                width: 100%;
                object-fit: cover;
                object-position: center;
                margin: 0 auto;
                img {
                  width: 100%;
                  height: auto;
                }
              }
            }
          }
        }

        @media (max-width: 600px) {
          .design-container {
            width: 95vw;
            padding: 1rem 0;
          }
          .design-header {
            margin: 3rem auto;
          }
        }

        @media (max-width: 550px) {
          .design-container {
            width: 99vw;
          }
        }
        @media (max-width: 500px) {
          .design-container {
            ul {
              grid-template-columns: 1fr;
            }
          }
        }
      }

      .design-header h2,
      .design-header p {
        opacity: 0;

        &.visible {
          animation: fadeIn 0.8s ease-out forwards;
        }

        &:nth-of-type(1) {
          animation-delay: 0s;
        }
        &:nth-of-type(2) {
          animation-delay: 0.1s;
        }
        &:nth-of-type(3) {
          animation-delay: 0.3s;
        }
      }

      .design-item {
        opacity: 0;
        transform: translateY(50px);
        transition: all 0.8s ease-out;

        &.visible {
          opacity: 1;
          transform: translateY(0);
        }

        &:nth-of-type(1) {
          transition-delay: 0s;
        }
        &:nth-of-type(2) {
          transition-delay: 0.1s;
        }
        &:nth-of-type(3) {
          transition-delay: 0.2s;
        }
        &:nth-of-type(4) {
          transition-delay: 0.3s;
        }
        &:nth-of-type(5) {
          transition-delay: 0.4s;
        }
        &:nth-of-type(6) {
          transition-delay: 0.5s;
        }
      }
    }
  </style>

  <script>
    function setupTitleObserver() {
      const elementsToObserve = [
        ...document.querySelectorAll(".design-header h2, .design-header p"),
        ...document.querySelectorAll(".design-item"),
      ];

      if (!elementsToObserve.length) return;

      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              obs.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.2 },
      );

      elementsToObserve.forEach((el) => {
        el.classList.remove("visible");
        observer.observe(el);
      });
    }

    document.addEventListener("astro:page-load", setupTitleObserver);
    document.addEventListener("DOMContentLoaded", setupTitleObserver);
  </script>
</Layout>
