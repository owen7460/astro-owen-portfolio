<style lang="scss">
  :root {
    --cardHeight: 40vw;
    --cardMargin: 4vw;
  }

  .hero {
    display: grid;
    justify-content: center;
    align-items: center;

    width: 100vw;
    height: 100vh;

    color: var(--text-color);
    text-align: center;

    h1 {
      font-size: 3.4vw;
      margin-bottom: 3.2vw;
      animation: fadeIn 0.4s ease-in-out forwards;
    }
    p {
      font-size: 1.8vw;
      font-weight: 300;
      letter-spacing: 0.1vw;
      animation: fadeIn 0.6s ease-in-out forwards;
      animation-delay: 0.1s;
      margin-bottom: 2vw;
    }
    p:nth-of-type(2) {
      font-size: 1vw;
      font-weight: 100;
      animation-delay: 0.2s;
    }
  }

  .projects {
    width: 80vw;
    margin: 0 auto;

    li {
      overflow: hidden;
      position: sticky;
      top: 0;
      display: grid;
      grid-template-columns: 1fr 1fr;
      height: var(--cardHeight);
      margin-bottom: var(--cardMargin);
      background-color: rgba(255, 255, 255, 0.4);
      box-shadow:
        0 0 10px 2px rgba(255, 255, 255, 0.8),
        3px 3px 5px 0 rgba(136, 136, 136, 0.5),
        1px 1px 3px 0 rgba(255, 255, 255, 0.6);
      backdrop-filter: blur(15px);
      border-radius: 1em;
      // animation: scaleIn 1s ease-in-out forwards;
      // animation-timeline: view();
      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
      }
      .right {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        .right-content {
          width: 80%;
          margin: 0 auto;
        }
        h2 {
          font-weight: 100;
          font-size: 2.5em;
        }
        p {
          margin: 1em 0;
          font-size: 0.72em;
          margin-left: 0.2em;
        }
        .buttons {
          display: flex;
          justify-content: flex-start;
          align-items: center;
          gap: 0.2em;
          margin-top: 2.6em;
          a {
            font-size: 0.82em;
            padding: 0.5em 1em;
            border-radius: 26px;
            margin-right: 1em;
            border: 1px solid var(--text-color);
            backdrop-filter: blur(60px);
            background-color: transparent;
            &.view-project {
              background-color: var(--text-color);
              color: var(--background-color);
            }
            &:hover {
              box-shadow: 1px 2px 15px 1px rgba(96, 96, 96, 0.5);
            }
          }
        }
      }
    }
  }
  .content {
    width: 80vw;
    margin: 0 auto;
    p {
      font-size: 0.8em;
      line-height: 1.5;
    }
  }

  // @keyframes scaleIn {
  //   0% {
  //     transform: scaleX(1);
  //   }
  //   100% {
  //     transform: scaleX(1);
  //   }
  // }
</style>
