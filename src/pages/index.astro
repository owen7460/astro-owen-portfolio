---
import "../styles/global.scss";
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import blendbetter from "../assets/blendbetter.png";
import jokeshare from "../assets/jokeshare.jpg";
import owenkitchen from "../assets/owenkitchen.png";
import noirrose from "../assets/noirrose.png";
import portfolio from "../assets/portfolio.png";
---

<Layout>
  <main>
    <section class="hero">
      <div>
        <h1>Welcome to Owen's portfolio</h1>
        <p>Learning technologies to solve problems with the best solutions.</p>
        <p>This site is built with Astro*</p>
      </div>
    </section>

    <section class="projects">
      <ul>
        <li>
          <div class="left">
            <Image src={blendbetter} alt="Blendbetter Website" />
          </div>
          <div class="right">
            <div class="right-content">
              <h2>Blendbetter</h2>
              <p>
                An AI-powered web app that recommends better smoothie
                combinations by suggesting fruit pairings based on taste and
                nutrition.
              </p>
              <p>
                Full-stack project, built with Next.js, TypeScript, Tailwind
                CSS, and Shadcn UI.
              </p>
              <div class="buttons">
                <a
                  href="https://github.com/owen7460/nextjs-blendbetter"
                  target="_blank">View Code</a
                >
                <a
                  class="view-project"
                  href="https://nextjs-blendbetter.vercel.app"
                  target="_blank">View Project</a
                >
              </div>
            </div>
          </div>
        </li>
        <li>
          <div class="left">
            <Image src={jokeshare} alt="Jokeshare Website" />
          </div>
          <div class="right">
            <div class="right-content">
              <h2>Jokeshare</h2>
              <p>
                A single page app that allows users to share, like and collect
                jokes.
              </p>
              <p>Built with React, Zustand, Tailwind CSS</p>
              <div class="buttons">
                <a
                  href="https://github.com/owen7460/joke-share-react"
                  target="_blank">View Code</a
                >
                <a
                  class="view-project"
                  href="https://owenouyang.com/"
                  target="_blank">View Project</a
                >
              </div>
            </div>
          </div>
        </li>
        <li>
          <div class="left">
            <Image src={owenkitchen} alt="Owen's Kitchen Website" />
          </div>
          <div class="right">
            <div class="right-content">
              <h2>Owen's Kitchen</h2>
              <p>
                Owen’s Kitchen is a web-based ordering system built with PHP and
                MySQL, allowing users to browse menus, place orders, and manage
                basic order data efficiently.
              </p>
              <p>Built with PHP, MySQL, HTML, CSS, JavaScript</p>
              <div class="buttons">
                <a
                  class="view-project"
                  href="https://owen-kitchen.com/"
                  target="_blank">View Project</a
                >
              </div>
            </div>
          </div>
        </li>
        <li>
          <div class="left">
            <Image src={noirrose} alt="Noir Rose Website" />
          </div>
          <div class="right">
            <div class="right-content">
              <h2>Noir Rose</h2>
              <p>
                Noir Rose is a press-on nails brand website designed to showcase
                the brand identity and product collections, while providing a
                smooth and intuitive online shopping experience for customers.
              </p>
              <p>Built with Wordpress, Elementor, and WooCommerce.</p>
              <div class="buttons">
                <a
                  class="view-project"
                  href="https://noir-rose.shop/"
                  target="_blank">View Project</a
                >
              </div>
            </div>
          </div>
        </li>
        <li>
          <div class="left">
            <Image src={portfolio} alt="Portfolio Website" />
          </div>
          <div class="right">
            <div class="right-content">
              <h2>Portfolio</h2>
              <p>
                This portfolio website is built with Astro, and it showcases my
                projects and skills.
              </p>
              <p>Built with Astro, Sass.</p>
              <div class="buttons">
                <a
                  class="view-project"
                  href="https://github.com/owen7460/astro-owen-portfolio"
                  target="_blank">View Code</a
                >
              </div>
            </div>
          </div>
        </li>
      </ul>
    </section>
