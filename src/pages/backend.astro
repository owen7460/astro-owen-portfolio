                z-index: 10;
                @keyframes fastapi-animation {
                  from {
                    opacity: 0;
                  }
                  to {
                    opacity: 1;
                  }
                }
                animation-name: fastapi-animation;
                animation-duration: 0.6s;
                animation-timing-function: ease-in-out;
                animation-fill-mode: forwards;
              }
              #swagger {
                top: 67%;
                left: 0%;
                z-index: 4;
                @keyframes swagger-animation {
                  from {
                    left: 50%;
                    opacity: 0;
                  }
                  to {
