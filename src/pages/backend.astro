---
import "../styles/global.scss";
import Layout from "../layouts/Layout.astro";
const title: string = "Backend development | Owen Portfolio";
import { Image } from "astro:assets";
import frontendBanner from "../assets/backend/banner.jpg";
---

<Layout title={title}>
  <main>
    <section class="introduction">
      <div class="intro-text">
        <div class="left">
          <h1>Backend</h1>
          <p>
            Backend development is an essential part of implementing
            functionality. Thanks to tools like Node and Express, we can
            interact with databases and deliver the data users need. When
            designing products, I also take database usage into account, and
            considerations such as RESTful design and other best practices are
            included in the process.
          </p>
        </div>
        <div class="right">
          <p>Technologies | TypeScript, JavaScript</p>
          <p>Frameworks | Node.js, Express.js</p>
          <p>Database | MySQL, MongoDB</p>
          <p>Other | RESTful, API</p>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style lang="scss">
  header {
    .banner {
      width: 100vw;
      height: 30vh;
      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
      }
    }
  }
  main {
    h1 {
      font-size: 3.2rem;
      font-weight: 100;
      margin-bottom: 2rem;
    }

    h2 {
      font-size: 3.2rem;
      font-weight: 100;
      margin-bottom: 2rem;
    }
    p {
      font-size: 1.4rem;
      font-weight: 100;
      line-height: 1.5;
    }
    a {
      text-decoration: underline;
      color: var(--text-color);
      font-size: 1.4rem;
      font-weight: 100;
      margin-top: 2rem;
    }

    .introduction {
      width: 80vw;
      margin: 4rem auto 4rem;
    }
    .intro-text {
      text-align: left;
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 2rem;
      .left {
        width: 50%;
      }
      .right {
        width: 50%;
        text-align: right;
        margin-top: 5.6rem;
        p {
          font-size: 1rem;
        }
      }
    }
  }
</style>
