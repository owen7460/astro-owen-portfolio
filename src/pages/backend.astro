                animation-timing-function: ease-in-out;
                animation-fill-mode: forwards;
              }
              #postgresql {
                top: 58%;
                left: 20%;
                z-index: 6;
                @keyframes postgresql-animation {
                  from {
                    left: 50%;
                    opacity: 0;
                  }
                  to {
                    left: 30%;
                    opacity: 1;
                  }
                }
