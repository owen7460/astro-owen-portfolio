---
import "../styles/global.scss";
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
const title: string = "Backend development | Owen Portfolio";
import { Image } from "astro:assets";
import dorc1 from "../assets/backend/dorc1.png";
import dorc2 from "../assets/backend/dorc2.png";
import dorc3 from "../assets/backend/dorc3.png";
import dorc4 from "../assets/backend/dorc4.png";
import dorc5 from "../assets/backend/dorc5.png";
import rest from "../assets/backend/rest.png";
import swaggerdoc from "../assets/backend/swaggerdoc.png";
import { CarouselDApiDemo } from "../components/Caresoul";
// import Iridescence from "../components/Iridescence";
import { AccordionComponent } from "../components/Accordion";
import bgImage from "../assets/backend/bg-2.jpg";
---

<Layout title={title}>
  <main>
    <section class="back-section-1">
      <Image
        loading="eager"
        class="back-section-1-background-image"
        src={bgImage}
        alt="Background"
      />
      <!-- <Iridescence
        class="back-section-1-background"
        client:load
        color={[0.5, 0.6, 0.8]}
        mouseReact={false}
        amplitude={0.1}
        speed={1}
      /> -->

      <div class="back-section-1-text">
        <h1>Backend</h1>
        <div class="back-skills">
          <p class="back-animation-section-1-text">
            Technologies: Node.js, Python
          </p>
          <div class="back-line-1 back-line"></div>
          <p class="back-animation-section-1-text">
            Frameworks: Express.js, FastAPI
          </p>
          <div class="back-line-2 back-line"></div>
          <p class="back-animation-section-1-text">
            Database: MySQL, MongoDB, PostgreSQL
          </p>
          <div class="back-line-3 back-line"></div>
          <p class="back-animation-section-1-text">
            Other: RESTful, Swagger, GraphQL, Postman, Docker, Coolify
          </p>
          <div class="back-line-4 back-line"></div>
        </div>
        <div class="back-description">
          <p class="back-animation-section-1-text">
            Backend development is equally engaging to me, as it brings ideas to
            life on the server side and powers the functionality behind user
            experiences. Seeing how different features are implemented and how
            services are delivered to users makes the process both challenging
            and rewarding
          </p>
          <p class="back-animation-section-1-text">
            Understanding API design and database structure helps me create more
            efficient and scalable applications. This full-stack perspective
            allows me to better connect UI with data and design more practical,
            well-rounded products. It also strengthens my ability to collaborate
            with designers, frontend, and backend developers, enabling clearer
            communication and smoother integration across different parts of a
            project
          </p>
        </div>
      </div>
    </section>

    <section class="back-section-2">
      <div class="back-section-2-left">
        <div class="back-dorc-card back-dorc1">
          <Image loading="eager" src={dorc1} alt="Card for Owen's Kitchen" />
        </div>
        <div class="back-dorc-card back-dorc2">
          <Image loading="eager" src={dorc2} alt="Card for Owen's Kitchen" />
        </div>
        <div class="back-dorc-card back-dorc3">
          <Image loading="eager" src={dorc3} alt="Card for Owen's Kitchen" />
        </div>
        <div class="back-dorc-card back-dorc4">
          <Image loading="eager" src={dorc4} alt="Card for Owen's Kitchen" />
        </div>
        <div class="back-dorc-card back-dorc5">
          <Image loading="eager" src={dorc5} alt="Card for Owen's Kitchen" />
        </div>
      </div>
      <div class="back-section-2-right">
        <h2 class="back-animation-title">
          DORC <span>MERN Stack Project</span>
        </h2>
        <p class="back-animation-text">
          DORC is a MERN stack RPG-style productivity app that gamifies
          habit-building. Users create quests, earn XP, level up, unlock badges,
          and join guilds to stay motivated.
        </p>
        <p class="back-animation-text">
          This was a collaborative full-stack project with a separated frontend
          and backend architecture. I primarily worked on backend development,
          built RESTful APIs and designed database schema.
        </p>
      </div>
    </section>

    <section class="back-section-3">
      <div class="back-section-3-left">
        <h2 class="back-animation-title">
          RESTful API<span>API Design and Implementation</span>
        </h2>
        <p class="back-animation-text">
          RESTful APIs are the foundation of modern web applications. They
          provide a standardized way to interact with backend services, making
          it easier to build and maintain applications. I have experience
          building RESTful APIs with Express.js and FastAPI, and working with
          databases such as PostgreSQL, MongoDB and MySQL.
        </p>
      </div>
      <div class="back-section-3-right">
        <Image class="back-rest-image" src={rest} alt="RESTful API" />
      </div>
    </section>

    <section class="back-section-4">
      <div class="back-section-4-left">
        <Image
          class="back-swaggerdoc-image"
          src={swaggerdoc}
          alt="SwaggerDoc"
          width={1879 * 0.55}
          height={1197 * 0.55}
        />
      </div>
      <div class="back-section-4-right">
        <h2 class="back-animation-title">
          Swagger Doc<span>API Documentation</span>
        </h2>
        <p class="back-animation-text">
          In the DORC project, I used SwaggerDoc to document the RESTful APIs I
          built for the backend. It generates an interactive API documentation
          interface, allowing team members to easily test endpoints and
          understand request and response formats. This improved communication
          between frontend and backend, and made the system easier to maintain
          and extend.
        </p>
      </div>
    </section>

    <section class="back-section-5">
      <div class="back-section-5-top">
        <h2 class="back-animation-title">
          Middlewares<span>Safety Does Matter</span>
        </h2>
        <p class="back-animation-text">
          In this project, I used tools such as Express Validator, JWT, RBAC,
          and OAuth2 to ensure secure and reliable data processing. These tools
          helped validate user input, protect authentication flows, and control
          access based on roles. I also adopted an MVC architecture to separate
          routes, controllers, and models, which improved code organization and
          made the backend easier to maintain and scale.
        </p>
      </div>
      <div class="back-section-5-bottom">
        <CarouselDApiDemo client:visible />
      </div>
    </section>

    <section class="back-section-6">
      <div class="back-section-6-left">
        <div class="back-database-card back-erd">
          <img src="/icons/erd.webp" alt="ERD" />
        </div>
        <!-- <div class="back-database-card back-schema">
          <img src="/icons/schema.webp" alt="Schema" />
        </div> -->
        <div class="back-database-card back-mysql">
          <img src="/icons/mysql.svg" alt="MySQL" />
        </div>
        <div class="back-database-card back-mongodb">
          <img src="/icons/mongo.png" alt="MongoDB" />
        </div>
        <!-- <div class="back-database-card back-graphql">
          <img src="/icons/graphql.png" alt="GraphQL" />
        </div> -->
        <div class="back-database-card back-postgresql">
          <img src="/icons/postgresql.png" alt="PostgreSQL" />
        </div>
      </div>
      <div class="back-section-6-right">
        <h2 class="back-animation-title">
          Database<span>From ERD to Implementation</span>
        </h2>
        <p class="back-animation-text">
          Databases are the backbone of modern web applications. My workflow
          begins with designing Entity Relationship Diagrams (ERD) to model data
          structures and relationships, followed by translating them into
          schemas and finally implementing them in the database. I have
          experience working with PostgreSQL, MongoDB and MySQL. This approach
          helps me build well-structured, scalable, and maintainable backend
          systems.
        </p>
      </div>
    </section>

    <section class="back-section-7">
      <div class="back-section-7-top">
        <h2 class="back-animation-title">
          Deployment<span>Docker & Coolify</span>
        </h2>
        <p class="back-animation-text">
          Docker is a containerization tool that allows me to package my
          application and its dependencies into a container, making it easier to
          deploy and scale. I have experience using Docker to deploy my
          applications to production environments.
        </p>
        <p class="back-animation-text">
          Coolify is a platform that allows me to deploy my applications to
          production environments. It provides a simple and easy-to-use
          interface for deploying and managing my backend services.
        </p>
      </div>
      <div class="back-section-7-bottom">
        <AccordionComponent client:visible />
      </div>
    </section>

    <section class="back-section-8">
      <div class="back-section-8-top">
        <h2 class="back-animation-title">
          AI and Future<span>Python, FastAPI and LangChain</span>
        </h2>
        <p class="back-animation-text">
          I’m a self-motivated learner who isn’t limited to a single stack. From
          frontend to backend, I’ve expanded my skills to include Python and
          FastAPI and currently learning LangChain to explore AI-driven
          development.
        </p>
      </div>
      <div class="back-section-8-mid">
        <div class="back-skills-chart">
          <div class="back-frontend">
            <!-- <hr class="ai-animation-hr ai-hr-1" /> -->
            <div class="back-line-1 back-ai-animation-line"></div>
            <p>Frontend</p>
          </div>

          <div class="back-backend">
            <!-- <hr class="ai-animation-hr ai-hr-2" /> -->
            <div class="back-line-2 back-ai-animation-line"></div>
            <p>Backend</p>
          </div>

          <div class="back-ai">
            <!-- <hr class="ai-animation-hr ai-hr-3" /> -->
            <div class="back-line-3 back-ai-animation-line"></div>
            <p>Python, FastAPI and LangChain..</p>
          </div>
        </div>
      </div>
      <div class="back-section-8-bottom">
        <div class="back-section-8-bottom-image">
          <img
            src="/icons/python.png"
            alt="Python"
            width={720 * 0.2}
            height={405 * 0.2}
          />
          <img
            src="/icons/fastapi.webp"
            alt="FastAPI"
            width={720 * 0.2}
            height={405 * 0.2}
          />
        </div>
        <p class="back-animation-text">
          I’m excited about the future of AI and hope to continue growing in
          this field, combining modern web technologies with intelligent systems
          to create more powerful applications.
        </p>
      </div>
    </section>
  </main>

  <style lang="scss">
    main {
      margin: 0 auto 10rem;
      h1 {
        font-size: var(--h1-size);
        font-weight: 100;
        margin-bottom: 2rem;
        animation: fadeIn-slightly 0.4s ease-in-out both;
      }

      h2 {
        font-size: var(--h2-size);
        font-weight: 100;
        margin-bottom: 2rem;
      }
      p {
        font-size: var(--p-size);
        font-weight: 100;
        line-height: 1.5;
      }
      // a {
      //   text-decoration: underline;
      //   color: var(--text-color);
      //   font-size: 1.4rem;
      //   font-weight: 100;
      //   margin-top: 2rem;
      // }
      section {
        max-width: 2400px;
        margin-left: auto;
        margin-right: auto;
      }
      .back-section-1 {
        width: 100vw;
        height: 100vh;
        position: relative;
        overflow: hidden;
        .back-section-1-background-image {
          position: absolute;
          height: 100%;
          width: 100%;
          // inset: 0;
          object-fit: cover;
          object-position: center;
        }
        .back-section-1-text {
          position: absolute;
          z-index: 10;
          color: var(--background-color);
          max-width: 80ch;
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%);
          .back-description {
            margin-top: 2rem;
          }
          @media (max-width: 500px) {
            width: 90%;
          }
        }
      }

      .back-section-2 {
        margin-top: 5rem;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        .back-section-2-left {
          width: 60%;
          height: 100%;
          position: relative;
          .back-dorc-card {
            position: absolute;
            border-radius: 16px;
            box-shadow: 5px 5px 10px 10px rgba(160, 160, 160, 0.4);
            overflow: hidden;
            width: 55%;
            height: auto;
            animation-timeline: scroll();
            animation-name: fadeIn-opacity-scroll-slow;
            // animation-duration: 1s;
            // animation-delay: 0.1s;
            animation-fill-mode: both;
            animation-range: entry 4% entry 15%;
            img {
              display: block;
              width: 100%;
              height: auto;
              object-fit: cover;
            }
          }
          .back-dorc1 {
            top: 20%;
            left: 1%;
            z-index: 1;
            animation-duration: 1s;
            animation-delay: 0.1s;
          }
          .back-dorc2 {
            top: 30%;
            left: 11%;
            z-index: 2;
            animation-duration: 1s;
            animation-delay: 0.3s;
          }
          .back-dorc3 {
            top: 40%;
            left: 21%;
            z-index: 3;
            animation-duration: 1s;
            animation-delay: 0.5s;
          }
          .back-dorc4 {
            top: 50%;
            left: 27%;
            z-index: 4;
            animation-duration: 1s;
            animation-delay: 0.7s;
          }
          .back-dorc5 {
            top: 60%;
            left: 37%;
            z-index: 5;
            animation-duration: 1s;
            animation-delay: 0.9s;
          }
        }
        .back-section-2-right {
          scroll-snap-stop: none;
          width: 40%;
          height: 100%;
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: flex-start;
          gap: 2rem;
          padding-right: 4rem;
          h2 {
            span {
              display: block;
              font-weight: 900;
              line-height: 1.2;
              margin-top: 0.4rem;
            }
          }
          @media (max-width: 800px) {
            padding-right: 2%;
          }
        }
        @media (max-width: 600px) {
          .back-section-2-left {
            width: 40%;
            .back-dorc-card {
              width: 100%;
            }
            .back-dorc1 {
              top: 20%;
              left: auto;
              right: 5%;
            }
            .back-dorc2 {
              top: 30%;
              left: auto;
              right: 5%;
            }
            .back-dorc3 {
              top: 40%;
              left: auto;
              right: 5%;
            }
            .back-dorc4 {
              top: 50%;
              left: auto;
              right: 5%;
            }

            .back-dorc5 {
              top: 60%;
              left: auto;
              right: 5%;
            }
          }
          .back-section-2-right {
            padding-left: 5%;
            padding-right: 5%;
            width: 60%;
          }
        }
      }

      .back-section-3 {
        margin-top: 5rem;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 2rem;
        overflow-x: clip;
        .back-section-3-left {
          width: 45%;
          display: flex;
          flex-direction: column;
          justify-content: flex-start;
          align-items: flex-start;
          gap: 2rem;
          padding-left: 10%;
          padding-right: 5%;
          h2 {
            span {
              display: block;
              font-weight: 900;
              line-height: 1.2;
              margin-top: 0.4rem;
            }
          }
        }
        .back-section-3-right {
          width: 55%;
          .back-rest-image {
            animation-timeline: view();
            animation-name: fadeIn-right;
            animation-duration: 1s;
            animation-delay: 0.2s;
            animation-fill-mode: both;
            animation-range: entry 50% entry 100%;
          }
        }
        @media (max-width: 900px) {
          .back-section-3-left {
            padding-left: 5%;
            padding-right: 2%;
            gap: 0;
          }
          .back-animation-title {
            margin-bottom: 1rem;
          }
        }
        @media (max-width: 800px) {
          .back-animation-title {
            margin-bottom: 0.5rem;
          }
        }
        @media (max-width: 700px) {
          gap: 1rem;
        }
        @media (max-width: 600px) {
          display: block;
          .back-section-3-left {
            width: 100%;
            padding-left: 5%;
            padding-right: 5%;
          }
          .back-section-3-right {
            width: 100%;
            padding: 2% 5%;
          }
        }
      }

      .back-section-4 {
        margin-top: 15rem;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 2rem;
        .back-section-4-left {
          width: 55%;
          .back-swaggerdoc-image {
            border-radius: 16px;
            animation-timeline: view();
            animation-name: fadeIn-left;
            animation-duration: 1s;
            animation-delay: 0.2s;
            animation-fill-mode: both;
            animation-range: entry 10% entry 55%;
          }
        }
        .back-section-4-right {
          width: 45%;
          display: flex;
          flex-direction: column;
          justify-content: flex-start;
          align-items: flex-start;
          gap: 2rem;
          padding-left: 10%;
          padding-right: 5%;
          h2 {
            span {
              display: block;
              font-weight: 900;
              line-height: 1.2;
              margin-top: 0.4rem;
            }
          }
        }
        @media (max-width: 900px) {
          .back-section-4-right {
            padding-left: 5%;
            padding-right: 5%;
            gap: 0;
          }

          .back-animation-title {
            margin-bottom: 1rem;
          }
        }
        @media (max-width: 800px) {
          .back-animation-title {
            margin-bottom: 0.5rem;
          }
        }
        @media (max-width: 700px) {
          gap: 1rem;
        }
        @media (max-width: 600px) {
          display: block;
          .back-section-4-left {
            width: 100%;
            padding-left: 5%;
            padding-right: 5%;
          }
          .back-section-4-right {
            width: 100%;
            padding: 2% 5%;
          }
        }
      }

      .back-section-5 {
        margin-top: 15rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 1.5vh;
        padding: 0 3rem;
        .back-section-5-top {
          max-width: 1200px;
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: center;
          text-align: center;
          h2 {
            span {
              display: block;
              font-weight: 900;
              line-height: 1.2;
              margin-top: 0.4rem;
            }
          }
        }
        .back-section-5-bottom {
          max-width: 2400px;
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: center;
          gap: 2rem;

          @media (max-width: 1600px) {
            // transform: scale(0.9);
            padding: 2rem;
            padding-top: 0;
          }
          @media (max-width: 1500px) {
            // transform: scale(0.8);
            padding: 2.5rem;
            padding-top: 0;
          }
          @media (max-width: 1400px) {
            // transform: scale(0.7);
            padding: 3rem;
            padding-top: 0;
          }
          @media (max-width: 1300px) {
            // transform: scale(0.6);
            padding: 3.5rem;
            padding-top: 0;
          }
          @media (max-width: 1200px) {
            // transform: scale(0.5);
            padding: 4rem;
            padding-top: 0;
          }
          @media (max-width: 1100px) {
            // transform: scale(0.4);
            padding: 4.5rem;
            padding-top: 0;
          }
          @media (max-width: 600px) {
            padding: 2rem;
            padding-top: 0;
          }
          @media (max-width: 550px) {
            width: 92%;
            margin: 0 auto;
            padding: 0;
            gap: 1rem;
            scale: 0.9;
          }
          @media (max-width: 500px) {
            width: 90%;
          }
          @media (max-width: 450px) {
            width: 88%;
          }
        }
        @media (max-width: 550px) {
          padding: 1%;
          gap: 0;
        }
      }
      .back-section-6 {
        margin-top: 22rem;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 4rem;
        max-width: 1600px;
        .back-section-6-left {
          width: 55%;
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
          gap: 2rem;
          padding-left: 10%;
          .back-database-card {
            will-change: transform, opacity;
            width: 100%;
            height: 150px;
            border-radius: 16px;
            box-shadow: 5px 5px 10px 10px rgba(160, 160, 160, 0.4);
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: #fff;
            p {
              font-size: var(--p-size);
              font-weight: 100;
              line-height: 1.5;
            }
          }

          .back-mysql {
            img {
              width: 70%;
              height: auto;
              object-fit: cover;
            }
          }
          .back-mongodb {
            img {
              width: 80%;
              height: auto;
              object-fit: cover;
            }
          }
          .back-postgresql {
            img {
              width: 90%;
              height: auto;
              object-fit: cover;
            }
          }
        }
        .back-section-6-right {
          width: 45%;
          display: flex;
          flex-direction: column;
          justify-content: flex-start;
          align-items: flex-start;
          gap: 2rem;
          padding-right: 10%;
          h2 {
            span {
              display: block;
              font-weight: 900;
              line-height: 1.2;
              margin-top: 0.4rem;
            }
          }
        }
        @media (max-width: 1600px) {
          align-items: flex-start;
          gap: 2rem;
        }
        @media (max-width: 1400px) {
          .back-section-6-left {
            grid-template-columns: repeat(auto-fit, minmax(2, 1fr));
          }
        }
        @media (max-width: 1300px) {
          .back-section-6-left {
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
            padding-left: 5%;
          }
          .back-section-6-right {
            padding-right: 5%;
          }
        }
        @media (max-width: 1200px) {
          .back-section-6-left {
            padding-left: 2%;
          }
          .back-section-6-right {
            padding-right: 2%;
          }
        }
        @media (max-width: 700px) {
          margin-top: 15rem;
        }
        @media (max-width: 550px) {
          margin-top: 10rem;
          .back-section-6-left {
            grid-template-columns: 1fr;
            gap: 1rem;
            padding-left: 5%;
            .back-database-card {
              height: 70px;
            }
          }
        }
      }

      .back-section-7 {
        margin-top: 25rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 0 5%;
        max-width: 1600px;
        .back-section-7-top {
          width: 100%;
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: flex-start;
          gap: 0.2rem;
          text-align: left;
          h2 {
            font-size: var(--h2-size);
            font-weight: 100;
            span {
              font-size: var(--h2-span-size);
              display: block;
              font-weight: 900;
              line-height: 1.2;
              margin-top: 0.4rem;
            }
          }
          p {
            font-size: var(--p-size);
            font-weight: 100;
            line-height: 1.5;
          }
        }
        .back-section-7-bottom {
          width: 100%;
          // height: calc(100% + 2rem);
          padding-top: 3rem;
          margin: 0 auto;
        }
      }

      .back-section-8 {
        margin: 25rem 0 5rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 5rem;
        padding: 0 5%;
        max-width: 2400px;
        p {
          max-width: 80ch;
        }
        .back-section-8-top {
          width: 100%;
          max-width: 2400px;
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: center;
          text-align: center;
          padding-bottom: 5rem;
          h2 {
            span {
              display: block;
              font-weight: 900;
              line-height: 1.2;
              margin-top: 0.4rem;
            }
          }
        }
        .back-section-8-mid {
          width: 100%;
          margin: 0 auto;
          .back-skills-chart {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 2rem;
            p {
              font-size: 0.9rem;
              font-weight: 100;
              padding-top: 0.8rem;
            }

            .back-ai-animation-line {
              will-change: transform;
              width: 100%;
              height: 6px;
              border-radius: 16px;
              // transform: scaleX(0);
              // transform-origin: left;
            }
            .back-frontend {
              width: 270px;
              height: 100px;
              .back-line-1 {
                height: 6px;
                border-radius: 16px;
                background-color: var(--text-color);
                box-shadow: 0 0 10px 2px rgba(49, 49, 49, 0.2);
                animation-delay: 0.1s;
              }
              // .ai-hr-1 {
              //   background-color: var(--text-color);
              //   box-shadow: 0 0 10px 2px rgba(49, 49, 49, 0.2);
              //   animation-delay: 0.2s;
              // }
            }
            .back-backend {
              width: 200px;
              height: 100px;
              // .ai-hr-2 {
              //   background-color: var(--text-color);
              //   box-shadow: 0 0 10px 2px rgba(49, 49, 49, 0.2);
              //   animation-delay: 0.4s;
              // }
              .back-line-2 {
                height: 6px;
                border-radius: 16px;
                background-color: var(--text-color);
                box-shadow: 0 0 10px 2px rgba(49, 49, 49, 0.2);
                animation-delay: 0.2s;
              }
            }
            .back-ai {
              width: 240px;
              height: 100px;
              // .ai-hr-3 {
              //   background-color: rgb(30, 195, 30);
              //   box-shadow: 0 0 10px 2px rgba(30, 195, 30, 0.4);
              //   animation-delay: 0.3s;
              // }
              .back-line-3 {
                height: 6px;
                border-radius: 16px;
                background-color: rgb(30, 195, 30);
                box-shadow: 0 0 10px 2px rgba(30, 195, 30, 0.4);
                animation-delay: 0.4s;
              }
            }
          }
        }
        .back-section-8-bottom {
          width: 100%;
          max-width: 2400px;
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: center;
          gap: 2rem;
          text-align: center;
          .back-section-8-bottom-image {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 2rem;
            img {
              opacity: 0;
              // transform: translateY(150px);
              will-change: transform, opacity;
              box-shadow: 0 0 10px 2px rgba(49, 49, 49, 0.2);
              border-radius: 16px;
            }
          }
        }
        @media (max-width: 700px) {
          margin: 15rem 0 5rem;
          gap: 2rem;
        }
        @media (max-width: 550px) {
          margin: 10rem 0 5rem;
          gap: 1rem;
        }
      }

      .back-animation-section-1-text {
        opacity: 0;
        animation: fadeIn-opacity 0.7s ease-in-out both;
      }

      .back-line {
        width: 0;
        height: 1px;
        background-color: var(--background-color);
        animation: grow-hr 0.6s ease-out forwards;
        @keyframes grow-hr {
          from {
            width: 0;
          }
          to {
            width: 100%;
          }
        }
      }

      .back-line-1 {
        animation-delay: 0.4s;
      }
      .back-line-2 {
        animation-duration: 0.9s;
        animation-delay: 0.5s;
      }
      .back-line-3 {
        animation-duration: 0.8s;
        animation-delay: 0.7s;
      }
      .back-line-4 {
        animation-duration: 0.4s;
        animation-delay: 0.9s;
      }
    }
  </style>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    // gsap.registerPlugin(ScrollTrigger);
    import { initGsap, setupReveal } from "../utils/gsap/initGsap";

    function setupTextRevealGsap() {
      setupReveal(
        ".back-section-2 .back-animation-title, .back-section-2 .back-animation-text",
        {
          trigger: ".back-section-2",
          start: "top 65%",
          y: 150,
          duration: 0.8,
          stagger: 0.3,
        },
      );
      setupReveal(
        ".back-section-3 .back-animation-title, .back-section-3 .back-animation-text",
        {
          trigger: ".back-section-3",
          start: "top 55%",
          y: 150,
          duration: 0.8,
          stagger: 0.3,
        },
      );
      setupReveal(
        ".back-section-4 .back-animation-title, .back-section-4 .back-animation-text",
        {
          trigger: ".back-section-4",
          start: "top 65%",
          y: 150,
          duration: 0.8,
          stagger: 0.3,
        },
      );
      setupReveal(
        ".back-section-5 .back-animation-title, .back-section-5 .back-animation-text",
        {
          trigger: ".back-section-5",
          start: "top 65%",
          y: 50,
          duration: 0.9,
          stagger: 0.12,
        },
      );
      setupReveal(
        ".back-section-6 .back-animation-title, .back-section-6 .back-animation-text",
        {
          trigger: ".back-section-6",
          start: "top 45%",
          y: 150,
          duration: 0.8,
          stagger: 0.12,
        },
      );
      setupReveal(
        ".back-section-7 .back-animation-title, .back-section-7 .back-animation-text",
        {
          trigger: ".back-section-7",
          start: "top 75%",
          y: 30,
          duration: 0.8,
          stagger: 0.12,
        },
      );
      setupReveal(
        ".back-section-8 .back-animation-title, .back-section-8 .back-animation-text",
        {
          trigger: ".back-section-8",
          start: "top 75%",
          y: 100,
          duration: 0.8,
          stagger: 0.12,
        },
      );
    }

    function setupSection6Gsap() {
      initGsap();
      const cards = document.querySelectorAll(
        ".back-section-6 .back-database-card",
      );
      if (!cards.length) return;

      cards.forEach((card) => {
        gsap.killTweensOf(card);
      });

      ScrollTrigger.getAll().forEach((trigger) => {
        if (
          trigger.trigger instanceof Element &&
          trigger.trigger.matches(".back-section-6-left")
        ) {
          trigger.kill();
        }
      });

      gsap.set(cards, {
        autoAlpha: 0,
        y: 150,
      });

      gsap.to(cards, {
        autoAlpha: 1,
        y: 0,
        duration: 0.8,
        ease: "power2.out",
        stagger: 0.12,
        scrollTrigger: {
          trigger: ".back-section-6-left",
          start: "top 78%",
          once: true,
        },
      });
    }

    function setupSection8Gsap() {
      initGsap();
      const lines = gsap.utils.toArray<HTMLDivElement>(
        ".back-section-8 .back-ai-animation-line",
      );
      const images = gsap.utils.toArray<HTMLImageElement>(
        ".back-section-8-bottom-image img",
      );

      lines.forEach((line) => {
        gsap.killTweensOf(line);
      });
      images.forEach((image) => {
        gsap.killTweensOf(image);
      });

      ScrollTrigger.getAll().forEach((trigger) => {
        if (
          trigger.trigger instanceof Element &&
          (trigger.trigger.matches(".back-section-8-mid") ||
            trigger.trigger.matches(".back-section-8-bottom-image"))
        ) {
          trigger.kill();
        }
      });

      gsap.set(lines, {
        scaleX: 0,
        transformOrigin: "left center",
      });

      gsap.set(images, {
        autoAlpha: 0,
        y: 50,
      });

      if (lines.length) {
        gsap.to(lines, {
          scaleX: 1,
          duration: 1.2,
          ease: "power2.out",
          stagger: 0.5,
          scrollTrigger: {
            trigger: ".back-section-8-mid",
            start: "top 70%",
            once: true,
          },
        });
      }

      if (images.length) {
        gsap.to(images, {
          autoAlpha: 1,
          y: 0,
          duration: 0.8,
          ease: "power2.out",
          stagger: 0.5,
          scrollTrigger: {
            trigger: ".back-section-8-bottom-image",
            start: "top 80%",
            once: true,
          },
        });
      }
    }

    function initBackendPage() {
      initGsap();
      setupTextRevealGsap();
      setupSection6Gsap();
      setupSection8Gsap();
    }

    document.addEventListener("DOMContentLoaded", initBackendPage);
    document.addEventListener("astro:page-load", initBackendPage);
  </script>
</Layout>
