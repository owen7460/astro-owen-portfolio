                  }
                }
                animation-name: graphql-animation;
                animation-duration: 0.6s;
                animation-timing-function: ease-in-out;
                animation-fill-mode: forwards;
              }
            }
          }

          .section-2 {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 2rem;
            height: 100vh;
            .section-2-left {
              width: 65%;
              height: 100%;
              padding-left: 10%;
              position: relative;
              .dorc-card {
                position: absolute;
                border-radius: 16px;
                box-shadow: 5px 5px 10px 10px rgba(160, 160, 160, 0.4);
                overflow: hidden;
                width: 600px;
                height: auto;
                animation-timeline: scroll();
                animation-name: fadeIn-opacity-scroll-slow;
                // animation-duration: 1s;
                // animation-delay: 0.1s;
                animation-fill-mode: both;
                animation-range: entry 15% entry 35%;
                img {
                  display: block;
                  width: 100%;
                  height: auto;
                  object-fit: cover;
                }
              }
              .dorc1 {
                top: 20%;
                left: 5%;
                z-index: 1;
                animation-duration: 1s;
                animation-delay: 0.1s;
              }
              .dorc2 {
                top: 30%;
                left: 15%;
                z-index: 2;
                animation-duration: 1s;
                animation-delay: 0.3s;
              }
              .dorc3 {
                top: 40%;
                left: 25%;
                z-index: 3;
                animation-duration: 1s;
                animation-delay: 0.5s;
              }
              .dorc4 {
                top: 50%;
                left: 35%;
                z-index: 4;
                animation-duration: 1s;
                animation-delay: 0.7s;
              }
              .dorc5 {
                top: 60%;
                left: 45%;
                z-index: 5;
                animation-duration: 1s;
                animation-delay: 0.9s;
              }
            }
            .section-2-right {
              scroll-snap-stop: none;
              width: 50%;
              display: flex;
              flex-direction: column;
              justify-content: flex-start;
              align-items: flex-start;
              gap: 2rem;
              padding-right: 10%;
              padding-left: 5%;
              h2 {
                span {
                  display: block;
                  font-weight: 900;
                  line-height: 1.2;
                  margin-top: 0.4rem;
                }
              }
            }
          }

          .section-3 {
            margin-top: 10rem;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 2rem;
            .section-3-left {
              width: 45%;
              display: flex;
              flex-direction: column;
              justify-content: flex-start;
              align-items: flex-start;
              gap: 2rem;
              padding-left: 10%;
              padding-right: 5%;
              h2 {
                span {
                  display: block;
                  font-weight: 900;
                  line-height: 1.2;
                  margin-top: 0.4rem;
                }
              }
            }
            .section-3-right {
              width: 55%;
              .rest-image {
                animation-timeline: view();
                animation-name: fadeIn-right;
                animation-duration: 1s;
                animation-delay: 0.2s;
                animation-fill-mode: both;
                animation-range: entry 50% entry 100%;
              }
            }
          }

          .section-4 {
            margin-top: 25rem;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 2rem;
            .section-4-left {
              width: 55%;
              .swaggerdoc-image {
                border-radius: 16px;
                animation-timeline: view();
                animation-name: fadeIn-left;
                animation-duration: 1s;
                animation-delay: 0.2s;
                animation-fill-mode: both;
                animation-range: entry 10% entry 55%;
              }
            }
            .section-4-right {
              width: 45%;
              display: flex;
              flex-direction: column;
              justify-content: flex-start;
              align-items: flex-start;
              gap: 2rem;
              padding-left: 10%;
              padding-right: 5%;
              h2 {
                span {
                  display: block;
                  font-weight: 900;
                  line-height: 1.2;
                  margin-top: 0.4rem;
                }
              }
            }
          }
          .section-5 {
            margin-top: 25rem;
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 2rem;
            padding: 0 3rem;
            .section-5-top {
              max-width: 1200px;
              display: flex;
              flex-direction: column;
              justify-content: center;
              align-items: center;
              text-align: center;
              h2 {
                span {
                  display: block;
                  font-weight: 900;
                  line-height: 1.2;
                  margin-top: 0.4rem;
                }
              }
            }
          }
          .section-5-bottom {
            max-width: 2400px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 2rem;
          }
        }

        .section-6 {
          margin-top: 25rem;
          height: 100vh;
          display: flex;
          justify-content: center;
          align-items: center;
          gap: 2rem;
        }

        .animation-title,
        .animation-text {
          opacity: 0;
        }
        .visible {
          animation: fadeIn 0.8s ease-out forwards;
        }

        .visible-text {
          animation: fadeIn-opacity 0.8s ease-in-out forwards;
          animation-delay: 0.1s;
        }
      </style>
      <script>
        function setupTitleObserver() {
          const elementsToObserve =
            document.querySelectorAll(".animation-title");

          if (!elementsToObserve.length) return;

          const observer = new IntersectionObserver(
            (entries, obs) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add("visible");
                  obs.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.7 },
          );

          elementsToObserve.forEach((el) => {
            el.classList.remove("visible");
            observer.observe(el);
          });
        }

        function setupTextObserver() {
          const elementsToObserve =
            document.querySelectorAll(".animation-text");

          if (!elementsToObserve.length) return;

          const observer = new IntersectionObserver(
            (entries, obs) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add("visible-text");
                  obs.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.7 },
          );

          elementsToObserve.forEach((el) => {
            el.classList.remove("visible-text");
            observer.observe(el);
          });
        }

        document.addEventListener("astro:page-load", setupTitleObserver);
        document.addEventListener("astro:page-load", setupTextObserver);
      </script>
    </section>

    <section class="section-6">
      <div class="section-6-left">
        <h2 class="animation-title">
          Middlewares<span>Safety Does Matter</span>
        </h2>
      </div>
      <div class="section-6-right"></div>
    </section>
  </main></Layout
>
