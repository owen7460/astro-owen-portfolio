---
import "../styles/global.scss";
const pathname = Astro.url.pathname;
---

<header>
  <nav>
    <ul>
      <li>
        <a
          id="home"
          href="/"
          style="anchor-name: --link1"
          class={pathname === "/" ? "active" : ""}>Home</a
        >
      </li>
      <li>
        <a
          href="/frontend"
          data-astro-prefetch="load"
          style="anchor-name: --link2"
          class={pathname === "/frontend/" ? "active" : ""}>Frontend</a
        >
      </li>
      <li>
        <a
          href="/backend"
          data-astro-prefetch="load"
          style="anchor-name: --link3"
          class={pathname === "/backend/" ? "active" : ""}>Backend</a
        >
      </li>
      <li>
        <a
          href="/design"
          style="anchor-name: --link4"
          class={pathname === "/design/" ? "active" : ""}>Design</a
        >
      </li>
      <li>
        <a
          href="/photography"
          data-astro-prefetch="load"
          style="anchor-name: --link5"
          class={pathname === "/photography/" ? "active" : ""}>Photography</a
        >
      </li>
      <li>
        <a
          href="/about"
          data-astro-prefetch="load"
          style="anchor-name: --link6"
          class={pathname === "/about/" ? "active" : ""}>About Me</a
        >
      </li>
    </ul>
    <div class="liquid"></div>
  </nav>
</header>

<style lang="scss">
  ul:has(li:nth-child(1):hover) ~ .liquid {
    position-anchor: --link1;
  }
  ul:has(li:nth-child(2):hover) ~ .liquid {
    position-anchor: --link2;
  }
  ul:has(li:nth-child(3):hover) ~ .liquid {
    position-anchor: --link3;
  }
  ul:has(li:nth-child(4):hover) ~ .liquid {
    position-anchor: --link4;
  }
  ul:has(li:nth-child(5):hover) ~ .liquid {
    position-anchor: --link5;
  }
  ul:has(li:nth-child(6):hover) ~ .liquid {
    position-anchor: --link6;
  }
  .active {
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 28px;
    width: 120%;
    box-shadow:
      var(--liquid-border-shadow),
      inset 0 0 10px 2px rgba(160, 160, 160, 0.4);
  }
  nav {
    position: fixed;
    z-index: 100;
    top: 1rem;
    left: 50%;
    width: 70%;
    max-width: 1200px;
    transform: translateX(-50%);
    font-size: 0.65em;
    padding: 1rem 1.4rem;
    background-color: rgba(255, 255, 255, 0.7);
    box-shadow: var(--liquid-border-shadow);
    border: 2px solid rgb(226, 226, 226);
    backdrop-filter: blur(8px);
    border-radius: 26px;

    .liquid {
      position: absolute;
      height: 0.2rem;
      width: anchor-size(width);
      left: anchor(left);
      border-radius: 4px;
      background-color: rgb(81, 81, 81);
      box-shadow: var(--liquid-border-shadow);
      bottom: 0;

      transition: 0.2s;
    }

    ul {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      margin-bottom: 0.2rem;
      li {
        a {
          font-weight: 500;
          padding: 0.6rem 1.6rem;
        }
        a:first-child {
          padding-left: 1.8rem;
        }
      }
      li:first-child {
        margin-right: auto;
      }
    }
  }
</style>
