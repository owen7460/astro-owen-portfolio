---
import "../styles/global.scss";
const pathname = Astro.url.pathname;
import { MenuIcon } from "lucide-react";
---

<header>
  <nav class="desktop-nav">
    <ul>
      <li>
        <a
          id="home"
          href="/"
          style="anchor-name: --link1"
          class={pathname === "/" ? "active" : ""}>Home</a
        >
      </li>
      <li>
        <a
          data-astro-prefetch="load"
          href="/frontend"
          style="anchor-name: --link2"
          class={pathname === "/frontend/" ? "active" : ""}>Frontend</a
        >
      </li>
      <li>
        <a
          href="/backend"
          data-astro-prefetch="load"
          style="anchor-name: --link3"
          class={pathname === "/backend/" ? "active" : ""}>Backend</a
        >
      </li>
      <li>
        <a
          href="/design"
          style="anchor-name: --link4"
          class={pathname === "/design/" ? "active" : ""}>Design</a
        >
      </li>
      <li>
        <a
          href="/photography"
          data-astro-prefetch="load"
          style="anchor-name: --link5"
          class={pathname === "/photography/" ? "active" : ""}>Photography</a
        >
      </li>
      <li>
        <a
          href="/aboutme"
          data-astro-prefetch="load"
          style="anchor-name: --link6"
          class={pathname === "/about/" ? "active" : ""}>About Me</a
        >
      </li>
    </ul>
    <div class="liquid"></div>
  </nav>
  <button
    type="button"
    class="mobile-nav-button"
    aria-label="Open navigation menu"
  >
    <MenuIcon />
  </button>
  <nav class="mobile-nav">
    <ul>
      <li>
        <a class={pathname === "/" ? "mobile-nav-active" : ""} href="/">Home</a>
      </li>
      <li>
        <a
          data-astro-prefetch="load"
          class={pathname === "/frontend/" ? "mobile-nav-active" : ""}
          href="/frontend">Frontend</a
        >
      </li>
      <li>
        <a
          data-astro-prefetch="load"
          class={pathname === "/backend/" ? "mobile-nav-active" : ""}
          href="/backend">Backend</a
        >
      </li>
      <li>
        <a
          data-astro-prefetch="load"
          class={pathname === "/design/" ? "mobile-nav-active" : ""}
          href="/design">Design</a
        >
      </li>
      <li>
        <a
          data-astro-prefetch="load"
          class={pathname === "/photography/" ? "mobile-nav-active" : ""}
          href="/photography">Photography</a
        >
      </li>
      <li>
        <a
          data-astro-prefetch="load"
          class={pathname === "/aboutme/" ? "mobile-nav-active" : ""}
          href="/aboutme">About Me</a
        >
      </li>
    </ul>
  </nav>
</header>

<style lang="scss">
  ul:has(li:nth-child(1):hover) ~ .liquid {
    position-anchor: --link1;
  }
  ul:has(li:nth-child(2):hover) ~ .liquid {
    position-anchor: --link2;
  }
  ul:has(li:nth-child(3):hover) ~ .liquid {
    position-anchor: --link3;
  }
  ul:has(li:nth-child(4):hover) ~ .liquid {
    position-anchor: --link4;
  }
  ul:has(li:nth-child(5):hover) ~ .liquid {
    position-anchor: --link5;
  }
  ul:has(li:nth-child(6):hover) ~ .liquid {
    position-anchor: --link6;
  }
  .active {
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 28px;
    width: 120%;
    box-shadow:
      var(--liquid-border-shadow),
      inset 0 0 10px 2px rgba(160, 160, 160, 0.4);
  }
  .desktop-nav {
    position: fixed;
    z-index: 100;
    top: 0.6rem;
    left: 50%;
    width: 70%;
    max-width: 1100px;
    transform: translateX(-50%);
    font-size: var(--nav-a-size);
    padding: 0.6rem 1.4rem;
    background-color: rgba(255, 255, 255, 0.7);
    box-shadow: var(--liquid-border-shadow);
    border: 2px solid rgb(226, 226, 226);
    backdrop-filter: blur(8px);
    border-radius: 26px;

    .liquid {
      position: absolute;
      height: 0.2rem;
      width: anchor-size(width);
      left: anchor(left);
      border-radius: 4px;
      background-color: rgb(81, 81, 81);
      box-shadow: var(--liquid-border-shadow);
      bottom: 0;
      transition: 0.3s;
    }

    ul {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      margin-bottom: 0.2rem;
      li {
        a {
          line-height: 1.5;
          font-weight: 500;
          padding: 0.6rem 1.4rem;
        }
        a:first-child {
          padding-left: 1.8rem;
        }
      }
      li:first-child {
        margin-right: auto;
      }
    }
    @media (max-width: 1000px) {
      display: none;
    }
  }
  .mobile-nav-button {
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    border: 2px solid rgb(226, 226, 226);
    font: inherit;
    display: block;
    position: fixed;
    top: 2%;
    right: 2%;
    z-index: 100;
    background-color: rgba(255, 255, 255, 0.7);
    box-shadow: var(--liquid-border-shadow);
    color: var(--text-color);
    backdrop-filter: blur(3px);
    border-radius: 26px;
    padding: 0.6rem 1.4rem;
    transition: all 0.2s ease-in-out;
    &:hover {
      background-color: rgba(255, 255, 255, 0.9);
      box-shadow: var(--liquid-border-shadow);
      border: 2px solid rgb(226, 226, 226);
      color: var(--text-color);
    }
    @media (min-width: 1001px) {
      display: none;
    }
  }
  .mobile-nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 99;
    background-color: rgba(0, 0, 0, 0.4);
    box-shadow: var(--liquid-border-shadow);
    border: 2px solid rgb(226, 226, 226);
    backdrop-filter: blur(8px);
    padding: 1.2rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-12px);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      visibility 0.25s ease;

    ul {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      li {
        a {
          font-size: var(--nav-a-size);
          font-weight: 500;
          padding: 0.6rem 1.4rem;
          color: var(--text-color);
          text-align: center;
          color: var(--background-color);
          border-bottom: 1px solid rgb(226, 226, 226);
          &.mobile-nav-active {
            font-weight: 900;
          }
        }
      }
      li:last-child a {
        border-bottom: none;
      }
    }
  }
  .mobile-nav.open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  @media (min-width: 1001px) {
    .mobile-nav,
    .mobile-nav.open {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-12px);
    }
  }
  // .mobile-nav-active {
  //   font-weight: 900;
  // }
</style>

<script>
  let navController: AbortController | undefined;

  function initHeaderMobileNav() {
    navController?.abort();

    navController = new AbortController();

    const button =
      document.querySelector<HTMLButtonElement>(".mobile-nav-button");
    const nav = document.querySelector<HTMLElement>(".mobile-nav");

    if (!button || !nav) return;

    const desktopMediaQuery = window.matchMedia("(min-width: 1001px)");

    const syncMobileNavState = (event?: MediaQueryListEvent) => {
      const isDesktop = event ? event.matches : desktopMediaQuery.matches;
      if (isDesktop) {
        nav.classList.remove("open");
      }
    };

    syncMobileNavState();

    desktopMediaQuery.addEventListener("change", syncMobileNavState, {
      signal: navController.signal,
    });

    button.addEventListener(
      "click",
      (event) => {
        event.stopPropagation();
        nav.classList.toggle("open");
      },
      { signal: navController.signal },
    );
    document.addEventListener(
      "click",
      (event) => {
        const target = event.target as Node | null;
        if (!target) return;

        const clickedInsideNav = nav.contains(target);
        const clickedButton = button.contains(target);

        if (!clickedInsideNav && !clickedButton) {
          nav.classList.remove("open");
        }
      },
      { signal: navController.signal },
    );
  }

  document.addEventListener("DOMContentLoaded", initHeaderMobileNav);
  document.addEventListener("astro:page-load", initHeaderMobileNav);
</script>
