---
import "../styles/global.scss";
---

<footer>
  <h2>Owen Ouyang</h2>
  <p>Full-Stack Developer & Designer Based in Calgary, Canada</p>
  <ul class="footer-skills">
    <li>Frontend</li>
    <li>Backend</li>
    <li>Design</li>
  </ul>
  <div class="slogan">
    <p>Let’s build something amazing together</p>
    <p>Available for new opportunities</p>
  </div>
  <p>
    Email: <a class="email" href="mailto:ouyangxiongwen@gmail.com"
      >ouyangxiongwen@gmail.com</a
    >
  </p>
  <p class="phone">Phone: <a href="tel:+13689992887">+1 368-999-2887</a></p>
  <div class="social-links">
    <a href="https://www.linkedin.com/in/xiongwenouyang/"
      ><img src="/linkedin.png" alt="linkedin" width="24" height="24" /></a
    >
    <a href="https://github.com/owen7460"
      ><img src="/github.png" alt="github" width="24" height="24" /></a
    >
    <a href="https://www.instagram.com/owenwebdesignerdeveloper/"
      ><img src="/instagram.png" alt="instagram" width="24" height="24" /></a
    >
    <a href="https://www.behance.net/xiongwenouyang"
      ><img src="/behance.png" alt="behance" width="24" height="24" /></a
    >
    <p>Copyright © 2026 Owen Ouyang. All rights reserved.</p>
  </div>
</footer>

<style lang="scss">
  footer {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    width: 100vw;
    padding: 2rem 0;
    color: var(--text-color);
    background-color: rgba(255, 255, 255, 0.7);
    box-shadow: 3px 3px 5px 0 rgba(136, 136, 136, 0.5);
    box-shadow: 1px 1px 3px 0 rgba(255, 255, 255, 0.6);
    border: 2px solid rgb(226, 226, 226);

    h2 {
      font-weight: 100;
      font-size: 1.3vw;
      margin-bottom: 1rem;
    }

    p {
      font-size: 0.7vw;
    }

    .footer-skills {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 1.4rem;
      margin: 0.6rem auto;
      background-color: rgb(243, 243, 243);
      padding: 0.4rem 0.6rem;
      border-radius: 32px;
      // box-shadow: var(--liquid-border-shadow);
      li {
        font-size: 0.8rem;
        font-weight: 100;
        padding: 0.6rem 1.6rem;
        background-color: rgba(255, 255, 255, 0.9);
        border-radius: 28px;
        box-shadow:
          var(--liquid-border-shadow),
          inset 0 0 10px 2px rgba(160, 160, 160, 0.2);
      }
    }

    .email {
      color: var(--text-color);
      text-decoration: underline;
    }

    .phone {
      margin: 0.9rem auto;
      a {
        color: var(--text-color);
        text-decoration: underline;
      }
    }

    .slogan {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 0.4rem;
      margin-bottom: 1rem;
    }

    .social-links {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 1rem;
    }
  }
</style>
