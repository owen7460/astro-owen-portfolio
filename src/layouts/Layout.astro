---
const {
  title = "Owen Portfolio | Full Stack Developer and Designer",
}: { title?: string } = Astro.props;
import "../styles/global.scss";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.png" />
    <meta
      name="description"
      content="Web Developer and Designer based in Calgary. Specializing in React, Astro, Next.js, UI/UX Design, and modern web development."
    />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
